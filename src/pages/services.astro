---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import LineIcon from "../components/LineIcon.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
  ],
};
---
<BaseLayout
  title="Power BI services for mid-sized companies | Alluvium"
  description="Power BI services for mid-sized companies: Quickstart, strategy, project management, dashboard optimization, training, retainer, and conversational analytics."
  canonicalPath="/services"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { label: "Services" }]} />
      <p class="kicker">Offerings</p>
      <h1>Power BI services</h1>
      <p class="lede">Focused advisory and delivery for mid-sized companies that need Power BI to support real decisions. Conversational analytics means asking a certified model—not a chatbot project.</p>
    </div>
  </header>
  <section class="band band-alt">
    <div class="wrap">
      <article class="card-feature">
        <LineIcon name="time" />
        <h2>Power BI Quickstart</h2>
        <p>Solve one painful reporting problem in two weeks. Flat fee $3,000. Training and one week of support included.</p>
        <p><a href="/power-bi-quickstart">See Power BI Quickstart</a></p>
      </article>
      <div class="cards-2">
        <article class="card">
          <LineIcon name="strategy" />
          <h2>Analytics strategy roadmap</h2>
          <p>Align data, analytics, and reporting goals. Identify high-impact use cases, design scalable Power BI frameworks, and sequence work from traditional reporting to asking a certified model.</p>
          <p><a href="/analytics-ai-strategy-roadmap">See the analytics strategy roadmap</a></p>
        </article>
        <article class="card">
          <LineIcon name="project" />
          <h2>Analytics project management and change leadership</h2>
          <p>Oversight for analytics and Power BI initiatives: scope, teams, timelines, communication, training, and adoption—so delivery does not stall in the last mile.</p>
          <p><a href="/data-project-management-change-leadership">See data &amp; analytics project management</a></p>
        </article>
        <article class="card">
          <LineIcon name="dashboard" />
          <h2>Dashboard optimization</h2>
          <p>Audit performance, adoption, and value. Streamline models and visuals so people actually use them.</p>
          <p><a href="/power-bi-dashboard-optimization-ai-insights">See dashboard optimization</a></p>
        </article>
        <article class="card">
          <LineIcon name="retainer" />
          <h2>Managed advisory retainer</h2>
          <p>Ongoing guidance on Power BI governance, semantic modeling, and program evolution—without standing up a large internal team.</p>
          <p><a href="/managed-advisory-retainer">See the managed advisory retainer</a></p>
        </article>
        <article class="card">
          <LineIcon name="training" />
          <h2>Power BI training</h2>
          <p>Get the team fluent on the Power BI model they already paid for — hands-on sessions, not a slide deck.</p>
          <p><a href="/power-bi-training">See Power BI training</a></p>
        </article>
        <article class="card">
          <LineIcon name="conversational" />
          <h2>Conversational analytics</h2>
          <p>Ask a certified Power BI or Fabric semantic model. Governed questions on trusted measures—not a chatbot project.</p>
          <p><a href="/conversational-analytics">See conversational analytics</a></p>
        </article>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
