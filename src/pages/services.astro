---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
  ],
};
---
<BaseLayout
  title="Services | Power BI Strategy, Optimization, and Advisory — Alluvium"
  description="Alluvium offerings: Analytics & AI Strategy Roadmap, data project management, dashboard optimization, managed advisory retainer, and Power BI Quickstart."
  canonicalPath="/services"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <p class="kicker">Offerings</p>
      <h1>Services</h1>
      <p class="lede">Focused advisory and delivery for mid-sized companies that need Power BI to support real decisions—and practical AI where it earns its keep.</p>
    </div>
  </header>
  <section class="band band-alt">
    <div class="wrap cards" style="grid-template-columns:repeat(2,1fr);">
      <article class="card">
        <h2>Analytics &amp; AI Strategy Roadmap</h2>
        <p>Align data, analytics, and AI goals. Identify high-impact use cases, design scalable frameworks, and outline a path from traditional reporting to intelligent automation.</p>
      </article>
      <article class="card">
        <h2>Data Project Management &amp; Change Leadership</h2>
        <p>Oversight for analytics and AI initiatives: scope, teams, timelines, communication, training, and adoption—so delivery does not stall in the last mile.</p>
      </article>
      <article class="card">
        <h2>Dashboard Optimization &amp; AI Insights Review</h2>
        <p>Audit performance, adoption, and value. Streamline models and visuals; add narrative summaries, anomaly detection, and predictive signals.</p>
        <p><a href="/power-bi-dashboard-optimization-ai-insights">Read the service page</a></p>
      </article>
      <article class="card">
        <h2>Managed Advisory Retainer</h2>
        <p>Ongoing guidance on Power BI governance, semantic modeling, AI integration, and program evolution—without standing up a large internal team.</p>
      </article>
      <article class="card">
        <h2>Power BI Quickstart</h2>
        <p>One critical report, rebuilt as an automated Power BI solution in two weeks. Starts at $2,500. Training and one week of support included.</p>
        <p><a href="/power-bi-quickstart">See Quickstart details</a></p>
      </article>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
