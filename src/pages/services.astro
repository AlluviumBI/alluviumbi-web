---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
  ],
};
---
<BaseLayout
  title="Services | Power BI Strategy, Optimization, and Advisory — Alluvium"
  description="Alluvium offerings: analytics strategy roadmap, data project management, dashboard optimization, managed advisory, Power BI Quickstart, and conversational analytics on a certified semantic model."
  canonicalPath="/services"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <p class="kicker">Offerings</p>
      <h1>Services</h1>
      <p class="lede">Focused advisory and delivery for mid-sized companies that need Power BI to support real decisions. AI here means conversational analytics on a certified model—not GPT apps or automations.</p>
    </div>
  </header>
  <section class="band band-alt">
    <div class="wrap cards" style="grid-template-columns:repeat(2,1fr);">
      <article class="card">
        <h2>Analytics strategy roadmap</h2>
        <p>Align data, analytics, and reporting goals. Identify high-impact use cases, design scalable Power BI frameworks, and sequence work from traditional reporting to conversational analytics on a certified model.</p>
        <p><a href="/analytics-ai-strategy-roadmap">Read the service page</a></p>
      </article>
      <article class="card">
        <h2>Data project management &amp; change leadership</h2>
        <p>Oversight for analytics and Power BI initiatives: scope, teams, timelines, communication, training, and adoption—so delivery does not stall in the last mile.</p>
        <p><a href="/data-project-management-change-leadership">Read the service page</a></p>
      </article>
      <article class="card">
        <h2>Dashboard optimization &amp; AI insights review</h2>
        <p>Audit performance, adoption, and value. Streamline models and visuals. Add narrative summaries and signals where they earn their keep in Power BI.</p>
        <p><a href="/power-bi-dashboard-optimization-ai-insights">Read the service page</a></p>
      </article>
      <article class="card">
        <h2>Managed advisory retainer</h2>
        <p>Ongoing guidance on Power BI governance, semantic modeling, and program evolution—without standing up a large internal team.</p>
        <p><a href="/managed-advisory-retainer">Read the service page</a></p>
      </article>
      <article class="card">
        <h2>Power BI Quickstart</h2>
        <p>One critical report, rebuilt as an automated Power BI solution in two weeks. Starts at $2,500. Training and one week of support included.</p>
        <p><a href="/power-bi-quickstart">See Quickstart details</a></p>
      </article>
      <article class="card">
        <h2>Conversational analytics</h2>
        <p>Ask a certified Power BI or Fabric semantic model. Governed chat on trusted measures—not a free-form chatbot, GPT app, or agent.</p>
        <p><a href="/conversational-analytics">Read the service page</a></p>
      </article>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
