---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, pageTitle } from "../lib/site";

const title = pageTitle("Check your email — Quickstart playbook");
const description =
  "Thanks for requesting the Power BI Quickstart playbook. Check your email or view the playbook now.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Tools", item: SITE.url + "/tools" },
      {
        "@type": "ListItem",
        position: 3,
        name: "Quickstart playbook",
        item: SITE.url + "/power-bi-quickstart-playbook",
      },
      {
        "@type": "ListItem",
        position: 4,
        name: "Thanks",
        item: SITE.url + "/power-bi-quickstart-playbook-thanks",
      },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/power-bi-quickstart-playbook-thanks"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs
          crumbs={[
            { href: "/", label: "Home" },
            { href: "/tools", label: "Tools" },
            { href: "/power-bi-quickstart-playbook", label: "Quickstart playbook" },
            { label: "Thanks" },
          ]}
        />
        <p class="kicker">Playbook</p>
        <h1>Check your email</h1>
        <p class="lede">
          Thanks — if email delivery is configured, the playbook is on the way. You can also view it now.
        </p>
      </div>
    </header>
    <section class="band band-alt">
      <div class="wrap-narrow">
        <h2>View the playbook</h2>
        <p>
          <a href="/playbooks/power-bi-quickstart-playbook.html">Open the Power BI Quickstart playbook</a>.
        </p>
        <p class="hero-actions">
          <a class="btn" href="/playbooks/power-bi-quickstart-playbook.html">View playbook</a>
          <a class="btn btn-ghost" href="/power-bi-quickstart">See Quickstart — $3,000</a>
        </p>
        <p>
          Prefer to talk it through?
          <a href="/contact">Book a Session</a>.
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
