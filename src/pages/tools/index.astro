---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumbs from "../../components/Crumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import { SITE, pageTitle } from "../../lib/site";

const title = pageTitle("Power BI tools");
const description =
  "Free Power BI tools from Alluvium: Model Health metadata score, Alluvium OEE Gauge for manufacturing, and a paste-ready date dimension.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Tools", item: SITE.url + "/tools" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: SITE.url + "/tools",
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url + "/" },
  },
];
---
<BaseLayout title={title} description={description} canonicalPath="/tools" jsonLd={jsonLd}>
  <header class="hero">
    <div class="wrap">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { label: "Tools" }]} />
      <p class="kicker">Tools</p>
      <h1>Power BI tools</h1>
      <p class="lede">
        Practical tools for mid-market Power BI teams — free model health scoring, a manufacturing OEE gauge on AppSource, and a paste-ready date dimension.
      </p>
    </div>
  </header>

  <section class="band band-alt" aria-labelledby="tools-heading">
    <div class="wrap">
      <h2 id="tools-heading" class="sr-only">Available tools</h2>
      <div class="cards-2 tools-free-row">
        <article class="card">
          <h2>Power BI Model Health</h2>
          <p>
            Free metadata score emailed after you upload semantic model definition files — relationships, DAX, Power Query (M), and RLS when present. No <code>.pbix</code>.
          </p>
          <p><a class="btn" href="/power-bi-model-health">Get your model health score</a></p>
          <p class="tools-secondary">
            Free score first. Want help on the worst findings?
            <a href="/contact">Model Health Deep Dive</a>
          </p>
        </article>
        <article class="card">
          <h2>Alluvium OEE Gauge</h2>
          <p>
            Free AppSource visual for manufacturing overall equipment effectiveness — Availability × Performance × Quality in one clear gauge.
          </p>
          <p><a class="btn" href="/power-bi-oee-gauge">View OEE Gauge</a></p>
          <p class="tools-secondary">
            <a href="https://marketplace.microsoft.com/en-us/product/power-bi-visuals/alluviumllc1788788073302.alluvium-oee-gauge" target="_blank" rel="noopener noreferrer">Get it on AppSource</a>
          </p>
        </article>
        <article class="card">
          <h2>Power BI Date Dimension</h2>
          <p>
            Free Power Query M date table — calendar, fiscal year, offsets, DateKey YYYYMMDD, and reverse-sort helpers. Paste into a blank query.
          </p>
          <p><a class="btn" href="/tools/date-dimension">Open date dimension</a></p>
          <p class="tools-secondary">Paste-ready M · .txt download · Sort By Column tips</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="engagements-heading">
    <div class="wrap">
      <h2 id="engagements-heading">Engagements</h2>
      <p class="lede">Flat-fee engagements after a Session — not self-serve checkout.</p>
      <div class="cards-2">
        <article class="card">
          <h3>Readiness &amp; Governance Groundwork</h3>
          <p>
            Not ready to hire a BI partner yet? Owners, definitions, publish path, and a 90-day plan
            so a later Quickstart or hire can succeed.
          </p>
          <p><a class="btn" href="/contact">Book a Session — ask about Groundwork</a></p>
        </article>
        <article class="card">
          <h3>Reporting Estate Audit</h3>
          <p>
            Power BI / Fabric sprawl: inventory, unused-signal review, Model Health on up to three exports,
            and a retire / remediate / invest matrix. Not a remodel — and not a promise of license savings.
            We qualify on a Session.
          </p>
          <p><a class="btn" href="/contact">Book a Session — ask about Estate Audit</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="guides-heading">
    <div class="wrap">
      <h2 id="guides-heading">Guides</h2>
      <p class="lede">Lean checklists and playbooks for mid-market Power BI teams.</p>
      <div class="cards-2">
        <article class="card">
          <h3>Partner checklist</h3>
          <p>How to choose a Power BI partner for manufacturing and ops-heavy mid-market teams.</p>
          <p><a href="/how-to-choose-a-power-bi-partner">Open partner checklist</a></p>
        </article>
        <article class="card">
          <h3>Quickstart playbook</h3>
          <p>Email-gated playbook for the two-week rebuild path.</p>
          <p><a href="/power-bi-quickstart-playbook">Get the playbook</a></p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .card .btn {
    display: inline-block;
    margin-top: 0.35rem;
  }
  .tools-price {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .tools-secondary {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }
  .tools-secondary a {
    color: var(--accent);
    text-underline-offset: 0.18em;
  }
  /* Third free-tool card sits in the same section; 3-up on wide so Model Health + OEE + Date Dimension share one row */
  .tools-free-row {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 960px) {
    .tools-free-row {
      grid-template-columns: 1fr;
    }
  }
</style>
