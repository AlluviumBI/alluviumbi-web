---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, pageTitle } from "../lib/site";

const title = pageTitle("Power BI model health score");
const description =
  "Upload Power BI semantic model metadata for a free scored review—relationships, DAX, Power Query (M), and RLS. Prioritized fixes by email.";

const whatYouGet = [
  "A clear <strong>score out of 100</strong> so you know if the model is green, yellow, or in the danger zone",
  "<strong>Top 5 fixes</strong> ranked by impact — not a 40-item laundry list",
  "Findings that explain <strong>why it matters</strong>, <strong>what breaks if you ignore it</strong>, and <strong>what improves when you fix it</strong>",
  "Coverage across <strong>relationships, DAX, Power Query (M), and row-level security</strong> when those show up in the export",
  "A report written like a senior model review — with a path to <strong>Book a Session</strong> if you want help remediating",
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Tools", item: SITE.url + "/tools" },
      {
        "@type": "ListItem",
        position: 3,
        name: "Power BI model health score",
        item: SITE.url + "/power-bi-model-health",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: SITE.url + "/power-bi-model-health",
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url + "/" },
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/power-bi-model-health"
  jsonLd={jsonLd}
>
  <article class="mh-page">
    <header class="hero">
      <div class="wrap">
        <Crumbs
          crumbs={[
            { href: "/", label: "Home" },
            { href: "/tools", label: "Tools" },
            { label: "Power BI model health score" },
          ]}
        />
        <p class="kicker">Free review</p>
        <h1>Power BI model health score</h1>
        <p class="lede">
          Upload your semantic model metadata. Get a scored email with prioritized fixes — relationships, DAX, Power Query (M), and row-level security when present.
        </p>
      </div>
    </header>

    <section class="band band-alt" aria-labelledby="mh-get">
      <div class="wrap-narrow">
        <h2 id="mh-get">What you get</h2>
        <ul class="mh-list">
          {whatYouGet.map((item) => (
            <li set:html={item} />
          ))}
        </ul>

        <h2 class="mh-files-heading">Accepted files</h2>
        <ul class="mh-chips" aria-label="Accepted file types">
          <li class="mh-chip mh-chip-preferred">
            <span class="mh-chip-label">Preferred</span>
            Zipped <code>.SemanticModel</code> folder from a <code>.pbip</code>, or TMDL folder zip / <code>.bim</code> (max 7&nbsp;MB)
          </li>
          <li class="mh-chip">
            <span class="mh-chip-label">Also</span>
            DAX Studio INFO CSV zip
          </li>
          <li class="mh-chip mh-chip-no">
            <span class="mh-chip-label">Not accepted</span>
            <code>.pbix</code> · Power BI cache (<code>.pbi</code> / <code>.abf</code>) · files over 7&nbsp;MB
          </li>
        </ul>
        <p class="mh-file-hint" id="mh-file-hint" role="status" aria-live="polite" hidden></p>

        <p class="mh-howto-row">
          <button type="button" class="mh-link" id="mh-open-modal" aria-haspopup="dialog" aria-controls="mh-modal">
            How to get this file →
          </button>
        </p>

        <form
          class="contact mh-form"
          name="model-health"
          method="POST"
          action="/model-health-success"
          enctype="multipart/form-data"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="model-health" />
          <p hidden>
            <label>
              Don’t fill this out if you’re human: <input name="bot-field" />
            </label>
          </p>
          <p>
            <label for="mh-email">Work email</label>
            <input
              id="mh-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="you@company.com"
            />
          </p>
          <p>
            <label for="mh-file">Model metadata file</label>
            <input
              id="mh-file"
              name="file"
              type="file"
              accept=".zip,.bim,.tmdl,application/zip"
              required
            />
          </p>
          <p><button class="btn" type="submit">Get my score</button></p>
        </form>

        <p class="mh-privacy">Work email required. Files used only to produce your report.</p>
      </div>
    </section>
  </article>

  <div
    class="mh-modal-overlay"
    id="mh-modal-overlay"
    hidden
  >
    <div
      class="mh-modal"
      id="mh-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="mh-modal-title"
      tabindex="-1"
    >
      <div class="mh-modal-header">
        <h2 id="mh-modal-title">How to export model metadata (no .pbix)</h2>
        <button type="button" class="mh-modal-close" id="mh-close-modal" aria-label="Close">
          ×
        </button>
      </div>
      <div class="mh-modal-body">
        <section class="mh-option">
          <h3>Option A — Power BI Project <span class="mh-rec">(recommended)</span></h3>
          <ol>
            <li>Open your <code>.pbip</code> project in Power BI Desktop (or File → Save as Power BI Project if you only have a <code>.pbix</code>).</li>
            <li>In File Explorer, find the folder ending in <code>.SemanticModel</code>.</li>
            <li>Zip that entire <code>.SemanticModel</code> folder — <strong>strip</strong> <code>.pbi</code> cache folders and any <code>.abf</code> so the zip stays under 7&nbsp;MB.</li>
            <li>Upload the zip. Do not upload the <code>.Report</code> folder.</li>
          </ol>
        </section>
        <section class="mh-option">
          <h3>Option B — Tabular Editor</h3>
          <ol>
            <li>Connect Tabular Editor to your Desktop model or dataset.</li>
            <li>File → Save to Folder (TMDL) or Save as <code>.bim</code>.</li>
            <li>Zip the folder / file and upload.</li>
          </ol>
        </section>
        <section class="mh-option">
          <h3>Option C — DAX Studio</h3>
          <ol>
            <li>Connect to the Desktop model.</li>
            <li>Export to CSV: INFO.TABLES, INFO.COLUMNS, INFO.RELATIONSHIPS, INFO.MEASURES.</li>
            <li>Zip the CSVs and upload. (Structure + DAX; limited M coverage.)</li>
          </ol>
        </section>
        <p class="mh-modal-note">
          We review model definition metadata only (max 7&nbsp;MB). Zip the <code>.SemanticModel</code> / TMDL folder and
          <strong>omit</strong> <code>.pbi</code> cache and <code>.abf</code> files. Do not upload a <code>.pbix</code>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .mh-list {
    margin: 0 0 1.75rem;
    padding-left: 1.15rem;
    color: var(--ink-soft);
  }
  .mh-list li {
    margin: 0 0 0.45rem;
  }
  .mh-files-heading {
    margin-top: 0.5rem;
  }
  .mh-chips {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .mh-chip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.65rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--line);
    background: var(--white);
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .mh-chip code {
    font-size: 0.88em;
    color: var(--ink);
  }
  .mh-chip-label {
    flex: 0 0 auto;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    line-height: 1;
  }
  .mh-chip-preferred .mh-chip-label {
    background: var(--accent);
    color: var(--white);
    border-color: var(--accent);
  }
  .mh-chip-no .mh-chip-label {
    color: #8a3a32;
    border-color: #c9a09a;
  }
  .mh-file-hint {
    margin: 0 0 1rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid #c9a09a;
    background: #fdf6f5;
    color: #5c2f2a;
    font-size: 0.92rem;
  }
  .mh-file-hint[data-level="warn"] {
    border-color: #c9a86a;
    background: #fffbf0;
    color: #5c4a1f;
  }
  .mh-howto-row {
    margin: 0 0 1.5rem;
  }
  .mh-link {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .mh-link:hover {
    color: var(--accent-hover);
  }
  .mh-form {
    margin-top: 0.25rem;
  }
  .mh-form input[type="file"] {
    padding: 0.55rem 0;
    border: 0;
    background: transparent;
  }
  .mh-privacy {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .mh-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(28, 28, 28, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
  .mh-modal-overlay[hidden] {
    display: none;
  }
  .mh-modal {
    width: min(100%, 36rem);
    max-height: min(90vh, 40rem);
    overflow: auto;
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    outline: none;
  }
  .mh-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem 0.75rem;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: var(--white);
  }
  .mh-modal-header h2 {
    font-size: 1.2rem;
    margin: 0;
    line-height: 1.3;
  }
  .mh-modal-close {
    flex: 0 0 auto;
    background: none;
    border: 0;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
    padding: 0.1rem 0.35rem;
  }
  .mh-modal-close:hover {
    color: var(--accent);
  }
  .mh-modal-body {
    padding: 1rem 1.25rem 1.35rem;
  }
  .mh-option {
    margin: 0 0 1.15rem;
  }
  .mh-option h3 {
    font-size: 1.05rem;
    margin: 0 0 0.45rem;
  }
  .mh-rec {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.88rem;
  }
  .mh-option ol {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--ink-soft);
  }
  .mh-option li {
    margin: 0 0 0.35rem;
  }
  .mh-option code,
  .mh-modal-note code {
    font-size: 0.88em;
    color: var(--ink);
  }
  .mh-modal-note {
    margin: 0.5rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--muted);
  }
</style>

<script>
  const MH_MAX_BYTES = 7 * 1024 * 1024;

  function initModelHealthModal() {
    const openBtn = document.getElementById("mh-open-modal");
    const closeBtn = document.getElementById("mh-close-modal");
    const overlay = document.getElementById("mh-modal-overlay");
    const dialog = document.getElementById("mh-modal");
    if (!openBtn || !closeBtn || !overlay || !dialog) return;

    let lastFocus = null;

    function openModal() {
      lastFocus = document.activeElement;
      overlay.hidden = false;
      document.body.style.overflow = "hidden";
      dialog.focus();
    }

    function closeModal() {
      overlay.hidden = true;
      document.body.style.overflow = "";
      if (lastFocus && typeof lastFocus.focus === "function") lastFocus.focus();
    }

    openBtn.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.hidden) {
        e.preventDefault();
        closeModal();
      }
    });
  }

  function initModelHealthFormGates() {
    const form = document.querySelector("form[name='model-health']");
    const fileInput = document.getElementById("mh-file");
    const hint = document.getElementById("mh-file-hint");
    if (!form || !fileInput || !hint) return;

    function setHint(message, level) {
      if (!message) {
        hint.hidden = true;
        hint.textContent = "";
        hint.removeAttribute("data-level");
        return;
      }
      hint.hidden = false;
      hint.textContent = message;
      hint.setAttribute("data-level", level || "error");
    }

    function validateFile(file) {
      if (!file) {
        setHint("");
        return true;
      }
      const name = (file.name || "").toLowerCase();
      if (name.endsWith(".pbix")) {
        setHint("Reject: .pbix files are not accepted. Export a .SemanticModel / TMDL zip or .bim instead (see How to get this file).");
        return false;
      }
      if (file.size > MH_MAX_BYTES) {
        setHint("Reject: file is over 7 MB. Strip .pbi cache / .abf from the zip and try again.");
        return false;
      }
      if (name.includes(".pbi") || name.endsWith(".abf") || name.includes("cache")) {
        setHint("Warning: this filename looks like a Power BI cache export. Prefer a stripped .SemanticModel / TMDL zip under 7 MB.", "warn");
        return true;
      }
      const okExt = name.endsWith(".zip") || name.endsWith(".bim") || name.endsWith(".tmdl");
      if (!okExt) {
        setHint("Prefer a .zip of *.SemanticModel / TMDL, or a .bim file. .pbix is not accepted.");
        return false;
      }
      setHint("");
      return true;
    }

    fileInput.addEventListener("change", () => {
      const f = fileInput.files && fileInput.files[0];
      validateFile(f);
    });

    form.addEventListener("submit", (e) => {
      const f = fileInput.files && fileInput.files[0];
      if (!validateFile(f)) {
        e.preventDefault();
        fileInput.focus();
      }
    });
  }

  function initModelHealth() {
    initModelHealthModal();
    initModelHealthFormGates();
  }

  initModelHealth();
  document.addEventListener("astro:page-load", initModelHealth);
</script>
