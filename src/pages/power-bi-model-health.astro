---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, pageTitle } from "../lib/site";

const title = pageTitle("Power BI model health score");
const description =
  "Upload Power BI semantic model metadata for a free scored review—relationships, DAX, Power Query (M), and RLS. Prioritized fixes by email.";

const whatYouGet = [
  "You get a score out of 100, so you can see whether the model is in good shape, needs work, or is likely to fail you at the close.",
  "The top five fixes, ranked by impact, not a list of forty items.",
  "Each finding says why it matters, what breaks if you leave it, and what gets better when you fix it.",
  "Coverage of relationships, DAX, Power Query (M), and row-level security when those show up in the export.",
  "The write-up reads like a senior model review. If you want help fixing the findings, <a href=\"/contact\">book a Session</a>.",
];
