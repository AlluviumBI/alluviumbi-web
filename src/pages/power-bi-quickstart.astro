---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import Crumbs from "../components/Crumbs.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { SITE } from "../lib/site";

const faqs = [
  {
    q: "What kinds of reports?",
    a: "Any report that takes too long to produce. Financial summaries, sales trackers, and operational metrics are common, from Excel, SQL, or cloud apps.",
  },
  {
    q: "How much time does my team give?",
    a: "About two to three hours, for the workshop and training. We handle the build.",
  },
  {
    q: "What happens after?",
    a: "You keep a working report and the skills to maintain it. Optional next steps include another report, model cleanup, workspace setup, or licensing guidance.",
  },
  {
    q: "Do we need a Power BI license?",
    a: "We tell you if Power BI Pro is required and how to set it up.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Power BI Quickstart", item: SITE.url + "/power-bi-quickstart" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Power BI Quickstart | Alluvium"
  description="Your most painful report, rebuilt in Power BI in two weeks, with hands-on training and a week of support."
  canonicalPath="/power-bi-quickstart"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs
          crumbs={[
            { href: "/", label: "Home" },
            { href: "/services", label: "Services" },
            { label: "Power BI Quickstart" },
          ]}
        />
        
        <h1 class="page-title">Power BI Quickstart</h1>
        <p class="lede">We rebuild your most painful report in two weeks. You get an automated Power BI report, hands-on training, and a week of support. Clear scope, no retainer required.</p>
      </div>
    </header>

    <section class="band band-alt">
      <div class="wrap prose">
        <h2>The report that eats the week</h2>
        <p>Someone rebuilds the same pack before every meeting, copying numbers from spreadsheets, SQL extracts, or cloud apps into slides by hand. It runs late, and the versions rarely match.</p>
        <p>Quickstart automates that report. No long program, no commitment after the support week.</p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>What the two weeks include</h2>
        <div class="cards">
          <article class="card">
            <h3>90-minute discovery workshop</h3>
            <p>We confirm the report, the decisions it supports, the data behind it, and who owns it.</p>
          </article>
          <article class="card">
            <h3>Data connection</h3>
            <p>We connect your Excel, SQL, or cloud sources so the report refreshes on its own.</p>
          </article>
          <article class="card">
            <h3>The Power BI report</h3>
            <p>An automated report replaces the manual rebuild, ready to filter, explore, and trust.</p>
          </article>
          <article class="card">
            <h3>Training and handoff</h3>
            <p>A hands-on session so your team can use and adjust the report with confidence.</p>
          </article>
          <article class="card">
            <h3>One week of support</h3>
            <p>We stay on after go-live for questions and fixes while the first real cycle runs.</p>
          </article>
          <article class="card">
            <h3>You decide what’s next</h3>
            <p>Continue with a next engagement, work from a prioritized backlog, or stop with everything handed over. Your call.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="band band-alt">
      <div class="wrap">
        <h2>Two weeks to build, one week of support</h2>
        <p>Your team invests about two to three hours, for the workshop and training. We handle the build.</p>
        <figure> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 150" role="img" aria-label="Three weeks: two weeks of build, then one week of support."> <line x1="48" y1="78" x2="592" y2="78" stroke="#dcdcdc" stroke-width="6" stroke-linecap="round"></line> <line x1="48" y1="78" x2="411" y2="78" stroke="#397fb0" stroke-width="6" stroke-linecap="round"></line> <line x1="411" y1="78" x2="592" y2="78" stroke="#397fb0" stroke-width="6" stroke-linecap="round" stroke-dasharray="2 10" opacity="0.55"></line> <rect x="36" y="108" width="371" height="8" rx="2" fill="#397fb0"></rect> <rect x="415" y="108" width="189" height="8" rx="2" fill="#397fb0" opacity="0.35"></rect> <text x="221" y="140" text-anchor="middle" font-family="Roboto, Arial, sans-serif" font-size="14" fill="#1c1c1c">Weeks 1–2: Build</text> <text x="510" y="140" text-anchor="middle" font-family="Roboto, Arial, sans-serif" font-size="14" fill="#1c1c1c">Week 3: Support</text> <circle cx="48" cy="78" r="14" fill="#fff" stroke="#397fb0" stroke-width="4"></circle> <circle cx="411" cy="78" r="14" fill="#1c1c1c"></circle> <circle cx="592" cy="78" r="14" fill="#fff" stroke="#397fb0" stroke-width="4"></circle> <rect x="38" y="36" width="22" height="18" rx="2" fill="none" stroke="#397fb0" stroke-width="2"></rect> <line x1="38" y1="42" x2="60" y2="42" stroke="#397fb0" stroke-width="2"></line> <rect x="397" y="32" width="28" height="22" rx="2" fill="none" stroke="#1c1c1c" stroke-width="2"></rect> <path d="M403 44 h8 M415 40 v8" stroke="#1c1c1c" stroke-width="2" fill="none"></path> <text x="48" y="24" text-anchor="middle" font-family="Roboto, Arial, sans-serif" font-size="12" fill="#333">Kickoff</text> <text x="411" y="24" text-anchor="middle" font-family="Roboto, Arial, sans-serif" font-size="12" fill="#333">Go-live</text> <text x="592" y="24" text-anchor="middle" font-family="Roboto, Arial, sans-serif" font-size="12" fill="#333">Done</text> </svg> <ol class="timeline-labels"> <li><strong>Weeks 1–2: Build.</strong> A 90-minute discovery workshop, then we connect the data, build the report, and train your team.</li> <li><strong>Go-live.</strong> The automated report replaces the manual rebuild.</li> <li><strong>Week 3: Support.</strong> We answer questions and fix issues while the report is in real use.</li> </ol> </figure>
      </div>
    </section>

    <section class="band">
      <div class="wrap prose">
        <h2>Who it is for</h2>
        <p>For teams that know which report is holding them back, people buried in the weekly spreadsheet, and leaders who want to see Power BI prove itself on real work before a larger effort.</p>
        <p>Not sure which report, data, or owner to start with? Begin with Readiness and Governance Groundwork instead.</p>
      </div>
    </section>

    <section class="band band-alt faq" aria-labelledby="faq">
      <div class="wrap">
        <h2 id="faq">Questions</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedLinks
      services={[
        { href: "/power-bi-training", label: "Power BI training" },
        { href: "/power-bi-dashboard-optimization-ai-insights", label: "Dashboard optimization" },
        { href: "/analytics-ai-strategy-roadmap", label: "Analytics strategy roadmap" },
      ]}
      posts={[
        { href: "/blog/excel-vs-power-bi-financial-reporting", label: "Excel vs Power BI for financial reporting" },
        { href: "/blog/unused-power-bi-licenses", label: "Unused Power BI licenses" },
        { href: "/blog/why-month-end-still-takes-a-week", label: "Why month-end still takes a week" },
      ]}
    />

    <CtaBand
      heading="Start with the report that matters most."
      text="Tell us about your reporting needs. We'll confirm the scope and get you started."
    />
  </article>
</BaseLayout>

<style>
  .timeline-labels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .timeline-labels li { margin: 0; color: var(--ink-soft); }
  .timeline-labels strong { display: block; color: var(--ink); font-weight: 500; }
  @media (max-width: 700px) {
    .timeline-labels { grid-template-columns: 1fr 1fr; }
  }
</style>
