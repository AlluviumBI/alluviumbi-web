---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Crumbs from "../components/Crumbs.astro";
import LineIcon from "../components/LineIcon.astro";
import { SITE, RELATED } from "../lib/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Power BI Quickstart", item: SITE.url + "/power-bi-quickstart" },
    ],
  },
];
---
<BaseLayout
  title="Power BI Quickstart in two weeks | Alluvium"
  description="Rebuild one painful report as Power BI in two weeks for $3,000. Discovery, semantic model, training, and a week of support included for mid-sized teams."
  canonicalPath="/power-bi-quickstart"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs crumbs={[{ href: "/", label: "Home" }, { href: "/services", label: "Services" }, { label: "Power BI Quickstart" }]} />
        <p class="kicker">Focused engagement</p>
        <h1>Power BI Quickstart</h1>
        <p class="lede">Solve one painful reporting problem in two weeks. We rebuild a critical report into an automated, dynamic Power BI solution.</p>
        <p><strong>Flat fee $3,000</strong>. No hidden costs, no long-term commitment.</p>
        <p><a class="btn" href="/contact">Book a Session</a></p>
      </div>
    </header>
    <figure class="still bw">
      <img src="/images/water-light.jpg" alt="" width="1600" height="1067" />
    </figure>
    <section class="band band-alt">
      <div class="wrap prose">
        <h2>Turn time-consuming reports into a Power BI semantic model the meeting can use</h2>
        <p>Manual reporting processes drain time. Alluvium’s Power BI Quickstart rebuilds one critical report into automated Power BI in two weeks. Flat fee $3,000.</p>
      </div>
    </section>
    <RelatedLinks services={RELATED["/power-bi-quickstart"].services} posts={RELATED["/power-bi-quickstart"].posts} />
    <CtaBand heading="Ready to solve your reporting pain in 2 weeks?" text="Book a Session to identify your critical report. Flat fee $3,000." />
  </article>
</BaseLayout>
