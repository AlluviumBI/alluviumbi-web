---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Terms", item: SITE.url + "/terms" },
  ],
};
---
<BaseLayout
  title="Terms of Use | Alluvium"
  description="Terms of use for the Alluvium website. Wisconsin, United States."
  canonicalPath="/terms"
  jsonLd={jsonLd}
>
  <article class="hero">
    <div class="wrap-narrow prose">
      <p class="kicker">Legal</p>
      <h1>Terms</h1>
      <p>By using alluviumbi.com, you agree to these terms. The site is operated by Alluvium in Wisconsin, United States.</p>
      <h2>Content</h2>
      <p>Site content is for general information about our advisory services. It is not legal, financial, or investment advice. Engagements are governed by a separate written agreement.</p>
      <h2>No warranties</h2>
      <p>The site is provided as is. We strive for accuracy but do not warrant that content is complete or current.</p>
      <h2>Limitation of liability</h2>
      <p>To the extent permitted by applicable U.S. law, Alluvium is not liable for damages arising from use of this website.</p>
      <h2>Contact</h2>
      <p>Questions: <a href="/contact">contact Alluvium</a>.</p>
    </div>
  </article>
</BaseLayout>
