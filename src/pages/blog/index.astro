---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumbs from "../../components/Crumbs.astro";
import { getCollection } from "astro:content";
import { SITE } from "../../lib/site";

const posts = (await getCollection("blog", ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Insights", item: SITE.url + "/blog" },
  ],
};
---
<BaseLayout
  title="Power BI insights for mid-sized companies | Alluvium"
  description="Power BI insights for mid-sized companies: models, close, licenses, adoption, and trusted numbers. Practical writing for executives and BI leaders now."
  canonicalPath="/blog"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { label: "Insights" }]} />
      <p class="kicker">Insights</p>
      <h1>Power BI insights for mid-sized companies</h1>
      <p class="lede">Short, practical pieces for C-suite and data leaders at mid-sized companies.</p>
    </div>
  </header>
  <section class="band band-alt">
    <div class="wrap">
      <h2>Latest Power BI articles</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h3 style="font-size:1.45rem;margin:0.2rem 0 0.4rem;">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
