---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection } from "astro:content";
import { SITE, seoTitle } from "../../lib/site";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();
const path = `/blog/${post.slug}`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Insights", item: SITE.url + "/blog" },
      { "@type": "ListItem", position: 3, name: post.data.title, item: SITE.url + path },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    author: { "@type": "Organization", name: "Alluvium", url: SITE.url },
    publisher: { "@type": "Organization", name: "Alluvium", url: SITE.url },
    mainEntityOfPage: SITE.url + path,
  },
];
---
<BaseLayout
  title={seoTitle(post.data.title)}
  description={post.data.description}
  crumbs={[{ name: "Home", href: "/" }, { name: "Insights", href: "/blog" }, { name: post.data.title, href: path }]}
  canonicalPath={path}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <p class="kicker">Insights</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </div>
    </header>
    <section class="band band-alt">
      <div class="wrap-narrow prose">
        <Content />
      </div>
    </section>
    <CtaBand text="Need a clearer finance or executive reporting stack? Book a Session." />
  </article>
</BaseLayout>
