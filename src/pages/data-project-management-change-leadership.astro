---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, RELATED } from "../lib/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Data & Analytics Project Management", item: SITE.url + "/data-project-management-change-leadership" },
    ],
  },
];
---
<BaseLayout
  title="Analytics project management | Alluvium"
  description="Analytics project management for Power BI: scope, RLS, refresh and gateway owners, training, and change leadership so last-mile delivery does not stall."
  canonicalPath="/data-project-management-change-leadership"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { href: "/services", label: "Services" }, { label: "Data & Analytics project management" }]} />
      <p class="kicker">Services</p>
      <h1>Data &amp; Analytics project management and change leadership</h1>
      <p class="lede">Oversight for analytics and Power BI initiatives: scope, teams, timelines, communication, training, and adoption—so delivery does not stall in the last mile.</p>
      <p><a class="btn" href="/contact">Book a Session</a></p>
    </div>
  </header>
  <figure class="still bw">
    <img src="/blog/why-month-end-still-takes-a-week-hero.jpg" alt="" width="1600" height="900" />
  </figure>
  <section class="band">
    <div class="wrap prose">
      <h2>Analytics project management, RLS, refresh, and adoption</h2>
      <p>The model can be right and still fail if finance never opens it. We treat adoption as part of delivery, not a slide at the end.</p>
    </div>
  </section>
  <RelatedLinks services={RELATED["/data-project-management-change-leadership"].services} posts={RELATED["/data-project-management-change-leadership"].posts} />
  <CtaBand heading="Keep the last mile from stalling" text="A session is enough to see whether the gap is the model, the plan, or adoption." />
</BaseLayout>
