---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, RELATED } from "../lib/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Conversational Analytics", item: SITE.url + "/conversational-analytics" },
    ],
  },
];
---
<BaseLayout
  title="Conversational analytics on a model | Alluvium"
  description="Conversational analytics on a certified Power BI semantic model. Ask trusted measures with RLS and refresh you can defend—not a Copilot experiment here."
  canonicalPath="/conversational-analytics"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { href: "/services", label: "Services" }, { label: "Conversational analytics" }]} />
      <p class="kicker">Services</p>
      <h1>Conversational Analytics</h1>
      <p class="lede">Ask a certified Power BI or Fabric semantic model. The answers come from measures leadership already trusts—not from a free-form chatbot.</p>
      <p><a class="btn" href="/contact">Book a Session</a></p>
    </div>
  </header>
  <figure class="still bw">
    <img src="/blog/ask-the-model-dont-screenshot-hero.jpg" alt="" width="1600" height="900" />
  </figure>
  <section class="band">
    <div class="wrap prose">
      <h2>Conversational analytics on a certified semantic model</h2>
      <p>You (or your analysts) ask a question in language. The answer is computed from a certified semantic model: one definition of revenue, margin, inventory, or cash.</p>
      <h2>What this is not</h2>
      <p>This is not a chatbot project. Alluvium’s work here is BI: Power BI and Fabric, certified models, and asking those models.</p>
    </div>
  </section>
  <RelatedLinks services={RELATED["/conversational-analytics"].services} posts={RELATED["/conversational-analytics"].posts} />
  <CtaBand heading="See if your model is ready to be asked" text="A session is enough to pick one certified model and the questions it should answer." />
</BaseLayout>
