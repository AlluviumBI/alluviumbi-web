---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page not found | Alluvium"
  description="That address is not on Alluvium. Continue to Power BI consulting home, services, or insights for mid-sized manufacturing, finance, and operations teams."
  canonicalPath="/404"
  robots="noindex, follow"
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>This page is not here</h1>
      <p class="lede">The address may have changed. Try the home page, services, or insights.</p>
      <p class="hero-actions">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/services">Services</a>
        <a class="btn btn-ghost" href="/blog">Insights</a>
      </p>
    </div>
  </section>
</BaseLayout>
