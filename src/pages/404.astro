---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page not found | Alluvium"
  description="The page you requested is not on the Alluvium site."
  canonicalPath="/404"
>
  <section class="hero">
    <div class="wrap-narrow">
      <p class="kicker">404</p>
      <h1>This page is not here</h1>
      <p class="lede">The address may have changed. Try the home page, services, or insights.</p>
      <p>
        <a class="btn" href="/">Home</a>
        &nbsp;
        <a class="btn btn-ghost" href="/services">Services</a>
        &nbsp;
        <a class="btn btn-ghost" href="/blog">Insights</a>
      </p>
    </div>
  </section>
</BaseLayout>
