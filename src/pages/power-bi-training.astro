---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import Crumbs from "../components/Crumbs.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { SITE } from "../lib/site";

const faqs = [
  {
    q: "Is this a generic Power BI class?",
    a: "No. Sessions run on the model your team already paid for. Your definitions, your reports, your questions.",
  },
  {
    q: "Who should attend?",
    a: "The people who own the numbers and the people expected to use them. Finance, operations, sales, and the analysts who support them.",
  },
  {
    q: "What do we leave with?",
    a: "A team that can open the report, answer the meeting questions, and change the report without us in the room.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Power BI training", item: SITE.url + "/power-bi-training" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Power BI training on your model | Alluvium"
  description="A slide class does not stick. We teach on your Power BI model, in the room, and leave your team able to change the report."
  canonicalPath="/power-bi-training"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs crumbs={[{ href: "/", label: "Home" }, { href: "/services", label: "Services" }, { label: "Power BI training" }]} />
        <p class="kicker">Power BI training</p>
        <h1>Train on the report you already use</h1>
        <p class="lede">A slide class does not stick. We teach on your model, in the room, and leave your team able to change the report.</p>
        <p class="hero-actions"><a class="btn" href="/contact">Book a Session</a></p>
      </div>
    </header>
    <section class="band">
      <div class="wrap prose">
        <h2>The class used a sample. Monday is still your file.</h2>
        <p>People sat through the buttons. They still cannot open the report they are supposed to trust, so the meeting goes back to the spreadsheet.</p>
        <p>The session is on the model you already paid for. Your definitions. Your reports. The questions your close, your pipeline, or your shop floor actually asks.</p>
      </div>
    </section>
    <section class="band band-alt">
      <div class="wrap">
        <h2>Everyone is in the same report</h2>
        <p>The slide stays in the background. The room works in the report they will open next week.</p>
        <figure>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 320" role="img" aria-label="A slide of text lines behind three screens. Each screen shows the same three bars.">
        <rect x="150" y="12" width="380" height="150" rx="4" fill="#f4f7fa" stroke="#dcdcdc" stroke-width="2"/>
        <line x1="178" y1="40" x2="420" y2="40" stroke="#dcdcdc" stroke-width="8" stroke-linecap="round"/>
        <line x1="178" y1="64" x2="490" y2="64" stroke="#dcdcdc" stroke-width="3" stroke-linecap="round"/>
        <line x1="178" y1="82" x2="460" y2="82" stroke="#dcdcdc" stroke-width="3" stroke-linecap="round"/>
        <line x1="178" y1="100" x2="440" y2="100" stroke="#dcdcdc" stroke-width="3" stroke-linecap="round"/>

        <rect x="36" y="118" width="184" height="132" rx="4" fill="#ffffff" stroke="#1c1c1c" stroke-width="2.5"/>
        <rect x="248" y="118" width="184" height="132" rx="4" fill="#ffffff" stroke="#1c1c1c" stroke-width="2.5"/>
        <rect x="460" y="118" width="184" height="132" rx="4" fill="#ffffff" stroke="#1c1c1c" stroke-width="2.5"/>

        <line x1="52" y1="226" x2="204" y2="226" stroke="#dcdcdc" stroke-width="2"/>
        <line x1="264" y1="226" x2="416" y2="226" stroke="#dcdcdc" stroke-width="2"/>
        <line x1="476" y1="226" x2="628" y2="226" stroke="#dcdcdc" stroke-width="2"/>

        <rect x="70" y="190" width="18" height="36" fill="#dcdcdc"/>
        <rect x="98" y="162" width="18" height="64" fill="#397fb0"/>
        <rect x="126" y="178" width="18" height="48" fill="#1c1c1c"/>
        <rect x="282" y="190" width="18" height="36" fill="#dcdcdc"/>
        <rect x="310" y="162" width="18" height="64" fill="#397fb0"/>
        <rect x="338" y="178" width="18" height="48" fill="#1c1c1c"/>
        <rect x="494" y="190" width="18" height="36" fill="#dcdcdc"/>
        <rect x="522" y="162" width="18" height="64" fill="#397fb0"/>
        <rect x="550" y="178" width="18" height="48" fill="#1c1c1c"/>

        <path d="M322 154 l0 26 6 6 3-9 9 2 z" fill="#1c1c1c"/>

        <rect x="28" y="250" width="200" height="10" rx="2" fill="#1c1c1c"/>
        <rect x="240" y="250" width="200" height="10" rx="2" fill="#1c1c1c"/>
        <rect x="452" y="250" width="200" height="10" rx="2" fill="#1c1c1c"/>
        <rect x="100" y="264" width="56" height="6" rx="1" fill="#dcdcdc"/>
        <rect x="312" y="264" width="56" height="6" rx="1" fill="#dcdcdc"/>
        <rect x="524" y="264" width="56" height="6" rx="1" fill="#dcdcdc"/>
      </svg>
        </figure>
      </div>
    </section>
    <section class="band">
      <div class="wrap prose">
        <h2>Who is in the room</h2>
        <p>The people who have to defend the numbers, and the people expected to use the report. Controllers, operations leads, sales managers, and the analysts who support them.</p>
        <p>It is not a certification course, and it is not a tour of every button.</p>
        <h2>How a session runs</h2>
        <p>It is live. A short agenda, real questions, and a screen on the report itself. Groups stay small so people click, filter, and get stuck while we are still there.</p>
        <p>You leave able to change the report when the question changes. You also leave with a short list of how each meeting question gets answered, a named owner for the model, and the next questions the team can run without us.</p>
        <p>If you want office hours after that, they sit with the <a href="/managed-advisory-retainer">managed advisory retainer</a>.</p>
      </div>
    </section>
    <section class="band band-alt faq" aria-labelledby="faq">
      <div class="wrap">
        <h2 id="faq">Questions</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
    <RelatedLinks
      services={[
        { href: "/data-project-management-change-leadership", label: "Analytics project management" },
        { href: "/managed-advisory-retainer", label: "Managed advisory retainer" },
        { href: "/analytics-ai-strategy-roadmap", label: "Analytics strategy roadmap" },
      ]}
      posts={[
        { href: "/blog/the-meeting-after-go-live", label: "The meeting after go-live" },
        { href: "/blog/change-management-for-analytics", label: "Change management for analytics" },
      ]}
    />
    <CtaBand heading="Name the report they have to open." text="Book a session. We will name who needs to be in the room, and which report they have to be able to change." />
  </article>
</BaseLayout>
