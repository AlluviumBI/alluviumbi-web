---
import BaseLayout from "../layouts/BaseLayout.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.alluviumbi.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Services",
        "item": "https://www.alluviumbi.com/services"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Power BI Training",
        "item": "https://www.alluviumbi.com/power-bi-training"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is this a generic Power BI class?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Sessions use your own reports, definitions, and questions."
        }
      },
      {
        "@type": "Question",
        "name": "Who should attend?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The people who own the numbers and those who use them: finance, operations, sales, and their analysts."
        }
      },
      {
        "@type": "Question",
        "name": "What do we leave with?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A team that can use the report, answer the key questions, and change it with confidence on their own."
        }
      }
    ]
  }
];
---
<BaseLayout
  title="Power BI Training | Alluvium"
  description="Hands-on Power BI training built on your own reports and data, so your team can use and adapt them with confidence."
  canonicalPath="/power-bi-training"
  jsonLd={jsonLd}
>
  <div class="service-fold">
<article>
<header class="hero"><div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true"> / </span><a href="/services">Services</a><span aria-hidden="true"> / </span><span>Power BI Training</span></nav>

<h1 class="page-title">Power BI Training</h1>
<p class="lede">Sample-file classes don't survive Monday. We train on your own reports, hands-on, and leave your team able to change them.</p>
</div></header>
<section class="band"><div class="wrap">
<h2>Generic classes don't stick</h2>
<p>People learn the buttons but still can't use the report they need, so the meeting goes back to the spreadsheet.</p>
<p>Our sessions use your own reports, definitions, and the real questions from your close, pipeline, or shop floor.</p>
</div></section>
<section class="band band-alt"><div class="wrap">
<h2>Everyone learns in the real report</h2>
<p>The team practices in the report they'll open next week.</p>
<figure class="diagram"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 230" role="img" aria-label="A report page in front. A faint slide sits behind it.">
<rect x="70" y="28" width="200" height="140" rx="3" fill="#f4f4f4" stroke="#e0e0e0"/>
<line x1="92" y1="58" x2="230" y2="58" stroke="#e0e0e0" stroke-width="6"/>
<line x1="92" y1="80" x2="200" y2="80" stroke="#e7e7e7" stroke-width="6"/>
<rect x="210" y="48" width="250" height="160" rx="4" fill="#ffffff" stroke="#1c1c1c" stroke-width="2.5"/>
<rect x="232" y="70" width="120" height="16" fill="#397fb0"/>
<rect x="232" y="104" width="28" height="72" fill="#1c1c1c"/>
<rect x="272" y="124" width="28" height="52" fill="#397fb0"/>
<rect x="312" y="112" width="28" height="64" fill="#397fb0" opacity="0.75"/>
<rect x="352" y="96" width="28" height="80" fill="#dcdcdc"/>
<circle cx="150" cy="196" r="10" fill="#397fb0"/>
<circle cx="400" cy="200" r="10" fill="#1c1c1c"/>
<circle cx="520" cy="196" r="10" fill="#397fb0"/>
</svg></figure>
</div></section>
<section class="band"><div class="wrap">
<h2>Who is in the room</h2>
<p>The people who own the numbers and the people who use them: typically controllers, operations leads, sales managers, and their analysts.</p>
<h2>How a session runs</h2>
<p>Live and hands-on, with a short agenda and real questions. Small groups, so people can click, filter, and get unstuck while we're in the room.</p>
<p>Your team leaves able to adapt the report as questions change, with a short guide to answering key questions, a named report owner, and next steps they can run on their own.</p>
<p>Ongoing office hours are available through the <a href="/managed-advisory-retainer">Managed advisory retainer</a>.</p>
<h2>Questions</h2>
<div class="faq">
<details><summary>Is this a generic Power BI class?</summary><p>No. Sessions use your own reports, definitions, and questions.</p></details>
<details><summary>Who should attend?</summary><p>The people who own the numbers and those who use them: finance, operations, sales, and their analysts.</p></details>
<details><summary>What do we leave with?</summary><p>A team that can use the report, answer the key questions, and change it with confidence on their own.</p></details>
</div>
</div></section>
<section class="band related-links" aria-labelledby="related-services">
  <div class="wrap">
    <h2 id="related-services">Related Power BI Services</h2>
    <ul><li><a href="/data-project-management-change-leadership">Data and analytics project management</a></li>
<li><a href="/managed-advisory-retainer">Managed advisory retainer</a></li>
<li><a href="/analytics-ai-strategy-roadmap">Analytics strategy roadmap</a></li></ul>
    <h2>Related Power BI Insights</h2>
    <ul><li><a href="/blog/the-meeting-after-go-live">The meeting after go-live</a></li>
<li><a href="/blog/change-management-for-analytics">Change management for analytics</a></li></ul>
  </div>
</section><section class="band band-cta" aria-labelledby="cta-heading">
  <div class="wrap">
    <h2 id="cta-heading">Let's build a confident team</h2>
    <p class="lede">Tell us about your team and the reports they rely on. We'll shape a session around them.</p>
    <p class="hero-actions"><a class="btn" href="/contact">Book a Session</a></p>
  </div>
</section></article>
  </div>
</BaseLayout>
