---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, pageTitle } from "../lib/site";

const title = pageTitle("Excel as BI to Power BI");
const description =
  "Stop running BI from brittle workbooks. Move the living model to Power BI so Excel is export-only.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Power BI migration", item: SITE.url + "/power-bi-migration" },
      { "@type": "ListItem", position: 3, name: "Excel as BI → Power BI", item: SITE.url + "/excel-as-bi-to-power-bi" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: SITE.url + "/excel-as-bi-to-power-bi",
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url + "/" },
  },
];
---
<BaseLayout title={title} description={description} canonicalPath="/excel-as-bi-to-power-bi" jsonLd={jsonLd}>
  <article>
<header class="hero">
  <div class="wrap">
        <Crumbs crumbs={[
            { href: "/", label: "Home" },
            { href: "/power-bi-migration", label: "Power BI migration" },
            { label: "Excel as BI → Power BI" }
          ]} />
        <div class="hero-grid">
      <div>
        <p class="kicker">Excel as BI → Power BI</p>
        <h1>Stop running the business from brittle workbooks</h1>
        <p class="lede">When Excel is the real reporting system, someone spends Monday moving numbers by hand. A wrong paste becomes an argument. The charts do not answer the next question without a new file. Owners and operations leads feel that every week. We put the living model in Power BI so Excel is the export, not the system of record.</p>
        <p class="hero-actions">
          <a class="btn" href="/contact">Book a Session</a>
        </p>
      </div>
      <figure class="diagram" aria-label="Manual Excel as BI versus Power BI living model">
        <svg viewBox="0 0 640 340" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Brittle Excel workbooks with errors dissolve into a living Power BI model and export-only tray.">
          <rect width="640" height="340" fill="#ffffff"/>
          <rect x="16" y="14" width="608" height="312" rx="20" fill="#f4f4f4"/>
          <rect x="40" y="40" width="568" height="268" rx="18" fill="#e6e6e6" opacity="0.55"/>
          <rect x="36" y="36" width="568" height="268" rx="18" fill="#ffffff" stroke="#dcdcdc"/>
          <rect x="36" y="36" width="568" height="28" rx="18" fill="#fafafa"/>
          <rect x="36" y="50" width="568" height="14" fill="#fafafa"/>
          <circle cx="56" cy="50" r="4.5" fill="#dcdcdc"/>
          <circle cx="72" cy="50" r="4.5" fill="#dcdcdc"/>
          <circle cx="88" cy="50" r="4.5" fill="#397fb0" opacity="0.75"/>
          <!-- scattered workbooks -->
          <rect x="78" y="100" width="82" height="108" rx="6" fill="#fff" stroke="#dcdcdc" transform="rotate(-12 119 154)"/>
          <rect x="110" y="110" width="82" height="108" rx="6" fill="#fff" stroke="#dcdcdc" transform="rotate(4 151 164)"/>
          <rect x="136" y="106" width="82" height="108" rx="6" fill="#fff" stroke="#999"/>
          <path d="M152 136h50M152 152h42M152 168h34" stroke="#dcdcdc" stroke-width="2.5"/>
          <rect x="88" y="236" width="14" height="28" rx="2" fill="#dcdcdc"/>
          <rect x="110" y="224" width="14" height="40" rx="2" fill="#dcdcdc"/>
          <rect x="132" y="230" width="14" height="34" rx="2" fill="#c8c8c8"/>
          <circle cx="210" cy="242" r="20" fill="#fff" stroke="#999" stroke-width="2.2"/>
          <path d="M200 232 L220 252 M220 232 L200 252" stroke="#999" stroke-width="2.5" stroke-linecap="round"/>
          <defs>
            <linearGradient id="xlF2" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0"/>
              <stop offset="1" stop-color="#ffffff" stop-opacity="1"/>
            </linearGradient>
          </defs>
          <rect x="230" y="88" width="80" height="190" fill="url(#xlF2)"/>
          <!-- living model product -->
          <rect x="290" y="84" width="290" height="196" rx="16" fill="#1c1c1c"/>
          <rect x="290" y="84" width="290" height="28" rx="16" fill="#2a2a2a"/>
          <rect x="290" y="98" width="290" height="14" fill="#2a2a2a"/>
          <circle cx="310" cy="98" r="4" fill="#555"/>
          <circle cx="324" cy="98" r="4" fill="#555"/>
          <circle cx="338" cy="98" r="4" fill="#397fb0"/>
          <rect x="310" y="124" width="250" height="10" rx="3" fill="#397fb0"/>
          <rect x="310" y="148" width="114" height="72" rx="10" fill="#2a2a2a"/>
          <rect x="328" y="176" width="16" height="30" rx="2" fill="#397fb0"/>
          <rect x="352" y="164" width="16" height="42" rx="2" fill="#555"/>
          <rect x="376" y="170" width="16" height="36" rx="2" fill="#397fb0"/>
          <rect x="446" y="148" width="114" height="72" rx="10" fill="#2a2a2a"/>
          <path d="M464 196 L482 162 L498 180 L528 148" fill="none" stroke="#397fb0" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="528" cy="148" r="4" fill="#397fb0"/>
          <rect x="310" y="236" width="250" height="30" rx="8" fill="#2a2a2a"/>
          <rect x="324" y="243" width="36" height="16" rx="3" fill="#3a3a3a" stroke="#555"/>
          <path d="M376 251 H500" stroke="#555" stroke-width="2"/>
          <circle cx="534" cy="251" r="9" fill="#397fb0"/>
          <path d="M529 251 L532.5 254.5 L541 245" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </figure>
    </div>
  </div>
</header>

<section class="band band-alt">
  <div class="wrap">
    <p class="kicker">Why leave</p>
    <h2>Manual work, errors, and analysis that cannot move</h2>
    <div class="beats">
      <article class="beat">
                <div class="mini">
          <svg viewBox="0 0 280 130" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Hand-off chain of workbooks rebuilt every week.">
              <rect width="280" height="130" fill="#ffffff"/>
              <rect x="8" y="8" width="264" height="114" rx="14" fill="#f4f4f4"/>
              <rect x="16" y="14" width="248" height="102" rx="12" fill="#ffffff" stroke="#dcdcdc"/>
              <rect x="16" y="14" width="248" height="16" rx="12" fill="#fafafa"/>
              <rect x="16" y="24" width="248" height="6" fill="#fafafa"/>
              <circle cx="28" cy="22" r="2.8" fill="#dcdcdc"/>
              <circle cx="38" cy="22" r="2.8" fill="#dcdcdc"/>
              <circle cx="48" cy="22" r="2.8" fill="#397fb0" opacity="0.7"/>
              <!-- three workbook cards in handoff -->
              <rect x="30" y="44" width="52" height="60" rx="6" fill="#fff" stroke="#dcdcdc"/>
              <path d="M42 60h28M42 72h22M42 84h16" stroke="#e0e0e0" stroke-width="2"/>
              <path d="M90 74 H108" stroke="#397fb0" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
              <path d="M102 68l8 6-8 6" fill="none" stroke="#397fb0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
              <rect x="114" y="44" width="52" height="60" rx="6" fill="#fff" stroke="#dcdcdc"/>
              <path d="M126 60h28M126 72h22M126 84h16" stroke="#e0e0e0" stroke-width="2"/>
              <path d="M174 74 H192" stroke="#397fb0" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
              <path d="M186 68l8 6-8 6" fill="none" stroke="#397fb0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
              <rect x="198" y="44" width="52" height="60" rx="6" fill="#fff" stroke="#999"/>
              <path d="M210 60h28M210 72h22M210 84h16" stroke="#dcdcdc" stroke-width="2"/>
              <!-- soft clock tick (weekly rebuild) -->
              <circle cx="224" cy="52" r="8" fill="none" stroke="#397fb0" stroke-width="1.4" opacity="0.4"/>
              <path d="M224 48 V52 H228" fill="none" stroke="#397fb0" stroke-width="1.4" stroke-linecap="round" opacity="0.4"/>
            </svg>
        </div>
        <h3>Manual effort</h3>
        <p>Someone rebuilds the pack every week. That time should go to running the business. Power BI refreshes the model so a person is not the glue between files.</p>
      </article>
      <article class="beat">
                <div class="mini">
          <svg viewBox="0 0 280 130" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Conflicting versions and error marks in workbook tiles.">
              <rect width="280" height="130" fill="#ffffff"/>
              <rect x="8" y="8" width="264" height="114" rx="14" fill="#f4f4f4"/>
              <rect x="16" y="14" width="248" height="102" rx="12" fill="#ffffff" stroke="#dcdcdc"/>
              <rect x="16" y="14" width="248" height="16" rx="12" fill="#fafafa"/>
              <rect x="16" y="24" width="248" height="6" fill="#fafafa"/>
              <circle cx="28" cy="22" r="2.8" fill="#dcdcdc"/>
              <circle cx="38" cy="22" r="2.8" fill="#dcdcdc"/>
              <circle cx="48" cy="22" r="2.8" fill="#397fb0" opacity="0.7"/>
              <rect x="40" y="44" width="200" height="60" rx="12" fill="#f4f4f4"/>
              <!-- bad tile -->
              <rect x="58" y="56" width="56" height="36" rx="5" fill="#fff" stroke="#999"/>
              <path d="M72 66 L100 82 M72 82 L100 66" stroke="#999" stroke-width="2.2" stroke-linecap="round"/>
              <!-- contested tile -->
              <rect x="132" y="56" width="56" height="36" rx="5" fill="#fff" stroke="#dcdcdc"/>
              <path d="M146 68h28M146 78h18" stroke="#e0e0e0" stroke-width="2"/>
              <!-- error badge -->
              <circle cx="210" cy="74" r="14" fill="#fff" stroke="#999" stroke-width="1.8"/>
              <path d="M203 67l14 14M217 67l-14 14" stroke="#999" stroke-width="2.2" stroke-linecap="round"/>
              <!-- soft dissolve hint toward calm -->
              <defs>
                <linearGradient id="xlErrFade" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#397fb0" stop-opacity="0"/>
                  <stop offset="1" stop-color="#397fb0" stop-opacity="0.18"/>
                </linearGradient>
              </defs>
              <rect x="190" y="44" width="50" height="60" rx="10" fill="url(#xlErrFade)"/>
            </svg>
        </div>
        <h3>Human error</h3>
        <p>A wrong cell, a wrong paste, or the wrong version of the file burns the meeting. Finance and operations argue the numbers instead of the decision. A certified Power BI model takes that argument off the table when the definitions are shared.</p>
      </article>
      <article class="beat">
                <div class="mini">
          <svg viewBox="0 0 280 130" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Flat Excel bars dissolve into a rich Power BI chart.">
              <rect width="280" height="130" fill="#ffffff"/>
              <rect x="8" y="8" width="264" height="114" rx="14" fill="#f4f4f4"/>
              <rect x="16" y="14" width="248" height="102" rx="12" fill="#ffffff" stroke="#dcdcdc"/>
              <rect x="16" y="14" width="248" height="16" rx="12" fill="#fafafa"/>
              <rect x="16" y="24" width="248" height="6" fill="#fafafa"/>
              <circle cx="28" cy="22" r="2.8" fill="#dcdcdc"/>
              <circle cx="38" cy="22" r="2.8" fill="#dcdcdc"/>
              <circle cx="48" cy="22" r="2.8" fill="#397fb0" opacity="0.7"/>
              <!-- weak flat bars -->
              <rect x="32" y="84" width="16" height="22" rx="2" fill="#dcdcdc"/>
              <rect x="54" y="72" width="16" height="34" rx="2" fill="#dcdcdc"/>
              <rect x="76" y="78" width="16" height="28" rx="2" fill="#c8c8c8"/>
              <defs>
                <linearGradient id="xlVizFade" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#ffffff" stop-opacity="0"/>
                  <stop offset="1" stop-color="#ffffff" stop-opacity="1"/>
                </linearGradient>
              </defs>
              <rect x="96" y="40" width="36" height="70" fill="url(#xlVizFade)"/>
              <!-- rich dark viz -->
              <rect x="128" y="40" width="120" height="66" rx="10" fill="#1c1c1c"/>
              <path d="M144 84 L164 56 L180 70 L204 46" fill="none" stroke="#397fb0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="204" cy="46" r="3.5" fill="#397fb0"/>
              <rect x="144" y="92" width="88" height="6" rx="2" fill="#2a2a2a"/>
            </svg>
        </div>
        <h3>Charts that cannot answer the next question</h3>
        <p>Excel charts stay flat. In Power BI, people filter and drill the same model instead of asking for another workbook.</p>
      </article>
    </div>
  </div>
</section>

<section class="band-cta cta-foot">
  <div class="wrap">
    <p class="kicker">Next step</p>
    <h2>Move the model out of Excel</h2>
    <p class="lede">Book a Session to decide which workbooks become Power BI first, and to land one certified slice while Excel becomes the export. See also <a href="/power-bi-migration">Power BI migration</a>.</p>
    <p class="hero-actions">
      <a class="btn" href="/contact">Book a Session</a>
    </p>
  </div>
</section>
  </article>
</BaseLayout>

<style>
  .diagram{border:1px solid var(--line);border-radius:10px;background:var(--paper-2);padding:.75rem;overflow:hidden}
  .diagram svg{width:100%;border-radius:6px}
  .beats,.paths{display:grid;grid-template-columns:repeat(3,1fr);gap:1.15rem}
  .beat,.path-card{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:1.1rem 1rem 1rem}
  .beat .mini,.path-card .mini{margin:0 0 .75rem;border-radius:6px;overflow:hidden;border:1px solid var(--line)}
  .beat p,.path-card p{margin:0;font-size:.95rem}
  a.path-card{text-decoration:none;color:inherit;display:block;transition:border-color .15s}
  a.path-card:hover{border-color:var(--accent)}
  .path-card .go{margin-top:.75rem;font-size:.85rem;color:var(--accent);font-weight:500}
  .reasons{display:grid;grid-template-columns:repeat(3,1fr);gap:1.15rem}
  .reason{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:1.1rem 1rem}
  .mig-back{font-size:.95rem;margin:0 0 1rem}
  .mig-back a{color:var(--accent)}
  @media(max-width:900px){
    .beats,.paths,.reasons{grid-template-columns:1fr}
  }
</style>
