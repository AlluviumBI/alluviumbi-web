---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, pageTitle } from "../lib/site";

const title = pageTitle("Acquisition Performance Visibility");
const description =
  "After a private equity buy, the buyer and the company that was acquired need one picture of performance. This engagement is a gap analysis and a sequenced roadmap. It is not the post-merger build.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Acquisition Performance Visibility", item: SITE.url + "/acquisition-performance-visibility" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: SITE.url + "/acquisition-performance-visibility",
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url + "/" },
  },
];
---
<BaseLayout title={title} description={description} canonicalPath="/acquisition-performance-visibility" jsonLd={jsonLd}>
  <article>
<header class="hero">
  <div class="wrap">
        <Crumbs crumbs={[
            { href: "/", label: "Home" },
            { label: "Acquisition Performance Visibility" }
          ]} />
      </div>
      <div class="wrap hero-grid">
        <div>
      <p class="kicker">Private equity · Acquired company · Power BI</p>
      <h1>Acquisition performance visibility</h1>
      <p class="lede">After a private equity buy, the buyer and the company that was acquired need one picture of performance. They do not need a pile of new reports that exist so someone can check a box. This engagement is a gap analysis and a sequenced roadmap from diligence through the first hundred days. It is not the post-merger build.</p>
      <p class="hero-actions">
        <a class="btn" href="/contact">Book a Session</a>
      </p>
    </div>
    <figure class="diagram" aria-label="Before checkbox report hell versus after shared performance picture and roadmap">
      <svg viewBox="0 0 640 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Checkbox hell fades at the edge of a shared performance workspace with dual synced panes and a sequenced roadmap.">
        <rect width="640" height="360" fill="#ffffff"/>
        <!-- ambient paper well -->
        <rect x="16" y="16" width="608" height="328" rx="20" fill="#f4f4f4"/>
        <!-- soft layered chrome -->
        <rect x="40" y="44" width="568" height="284" rx="18" fill="#e6e6e6" opacity="0.55"/>
        <rect x="36" y="40" width="568" height="284" rx="18" fill="#ffffff" stroke="#dcdcdc"/>
        <!-- titlebar -->
        <path d="M36 58 h568 v0" stroke="#dcdcdc"/>
        <rect x="36" y="40" width="568" height="28" rx="18" fill="#fafafa"/>
        <rect x="36" y="54" width="568" height="14" fill="#fafafa"/>
        <circle cx="56" cy="54" r="4.5" fill="#dcdcdc"/>
        <circle cx="72" cy="54" r="4.5" fill="#dcdcdc"/>
        <circle cx="88" cy="54" r="4.5" fill="#397fb0" opacity="0.75"/>
        <rect x="112" y="48" width="120" height="10" rx="3" fill="#ececec"/>
        <!-- ghost checklist (pain) — left margin only, soft opacity, not a half-panel -->
        <g opacity="0.55">
          <rect x="56" y="96" width="118" height="140" rx="10" fill="#f4f4f4" stroke="#dcdcdc" transform="rotate(-3 115 166)"/>
          <rect x="72" y="114" width="12" height="12" rx="2" fill="#fff" stroke="#b0b0b0" transform="rotate(-3 78 120)"/>
          <rect x="92" y="116" width="58" height="6" rx="2" fill="#dcdcdc" transform="rotate(-3 121 119)"/>
          <rect x="72" y="138" width="12" height="12" rx="2" fill="#fff" stroke="#b0b0b0" transform="rotate(-3 78 144)"/>
          <path d="M74 140 L82 148 M82 140 L74 148" stroke="#b0b0b0" stroke-width="1.5" transform="rotate(-3 78 144)"/>
          <rect x="92" y="140" width="50" height="6" rx="2" fill="#dcdcdc" transform="rotate(-3 117 143)"/>
          <rect x="72" y="162" width="12" height="12" rx="2" fill="#fff" stroke="#b0b0b0" transform="rotate(-3 78 168)"/>
          <path d="M74 164 L82 172 M82 164 L74 172" stroke="#b0b0b0" stroke-width="1.5" transform="rotate(-3 78 168)"/>
          <rect x="92" y="164" width="54" height="6" rx="2" fill="#dcdcdc" transform="rotate(-3 119 167)"/>
          <rect x="88" y="196" width="72" height="40" rx="5" fill="#fff" stroke="#dcdcdc" transform="rotate(6 124 216)"/>
        </g>
        <!-- fade into product -->
        <defs>
          <linearGradient id="apvFade2" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0"/>
            <stop offset="0.55" stop-color="#ffffff" stop-opacity="0.9"/>
            <stop offset="1" stop-color="#ffffff" stop-opacity="1"/>
          </linearGradient>
        </defs>
        <rect x="150" y="88" width="70" height="200" fill="url(#apvFade2)"/>
        <!-- SHARED PERFORMANCE WORKSPACE — the star product -->
        <rect x="208" y="88" width="368" height="208" rx="16" fill="#1c1c1c"/>
        <!-- soft inner glow plate -->
        <rect x="220" y="100" width="344" height="120" rx="12" fill="#242424"/>
        <!-- PE pane -->
        <rect x="232" y="112" width="148" height="96" rx="10" fill="#2e2e2e"/>
        <rect x="246" y="126" width="48" height="6" rx="2" fill="#555"/>
        <rect x="248" y="148" width="16" height="42" rx="3" fill="#397fb0"/>
        <rect x="272" y="160" width="16" height="30" rx="3" fill="#555"/>
        <rect x="296" y="152" width="16" height="38" rx="3" fill="#397fb0"/>
        <rect x="320" y="166" width="16" height="24" rx="3" fill="#555"/>
        <!-- Company pane (matching) -->
        <rect x="404" y="112" width="148" height="96" rx="10" fill="#2e2e2e"/>
        <rect x="418" y="126" width="48" height="6" rx="2" fill="#555"/>
        <rect x="420" y="148" width="16" height="42" rx="3" fill="#397fb0"/>
        <rect x="444" y="160" width="16" height="30" rx="3" fill="#555"/>
        <rect x="468" y="152" width="16" height="38" rx="3" fill="#397fb0"/>
        <rect x="492" y="166" width="16" height="24" rx="3" fill="#555"/>
        <!-- shared bridge node -->
        <circle cx="392" cy="160" r="11" fill="#1c1c1c" stroke="#397fb0" stroke-width="3"/>
        <circle cx="392" cy="160" r="4" fill="#397fb0"/>
        <path d="M380 160 H381" stroke="#397fb0" stroke-width="3" stroke-linecap="round"/>
        <path d="M403 160 H404" stroke="#397fb0" stroke-width="3" stroke-linecap="round"/>
        <!-- roadmap ribbon as product chrome -->
        <rect x="220" y="236" width="344" height="44" rx="10" fill="#242424"/>
        <circle cx="252" cy="258" r="10" fill="#397fb0"/>
        <circle cx="252" cy="258" r="3.5" fill="#fff"/>
        <path d="M262 258 H310" stroke="#397fb0" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="320" cy="258" r="10" fill="#397fb0"/>
        <circle cx="320" cy="258" r="3.5" fill="#fff"/>
        <path d="M330 258 H378" stroke="#397fb0" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="388" cy="258" r="10" fill="#397fb0"/>
        <circle cx="388" cy="258" r="3.5" fill="#fff"/>
        <path d="M398 258 H470" stroke="#397fb0" stroke-width="2.5" stroke-linecap="round" opacity="0.45"/>
        <rect x="478" y="244" width="70" height="28" rx="8" fill="#397fb0"/>
        <path d="M500 258 L506 264 L520 248" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </figure>
  </div>
</header>

<section class="band band-alt">
  <div class="wrap">
    <p class="kicker">Three beats</p>
    <h2>Where the definitions already disagree</h2>
    <div class="beats">
      <article class="beat">
        <div class="mini">
          <svg viewBox="0 0 280 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="280" height="150" fill="#fff"/>
            <rect x="16" y="24" width="100" height="102" rx="12" fill="#f4f4f4"/>
            <rect x="32" y="48" width="16" height="54" rx="3" fill="#999"/>
            <rect x="56" y="64" width="16" height="38" rx="3" fill="#b0b0b0"/>
            <rect x="80" y="56" width="16" height="46" rx="3" fill="#999"/>
            <rect x="164" y="24" width="100" height="102" rx="12" fill="#f4f4f4"/>
            <path d="M182 100 C190 70 210 55 246 42" fill="none" stroke="#999" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="246" cy="42" r="4" fill="#999"/>
            <circle cx="140" cy="75" r="18" fill="#fff" stroke="#397fb0" stroke-width="2.5"/>
            <path d="M132 67 L148 83 M148 67 L132 83" stroke="#397fb0" stroke-width="2.4" stroke-linecap="round"/>
          </svg>
        </div>
        <h3>The same performance, two vocabularies</h3>
        <p>Private equity and the acquired company often track different numbers under different names. We show where the definitions diverge, so both sides agree on what good means before anyone builds more reports.</p>
      </article>
      <article class="beat">
        <div class="mini">
          <svg viewBox="0 0 280 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="280" height="150" fill="#fff"/>
            <rect x="22" y="28" width="108" height="94" rx="14" fill="#1c1c1c"/>
            <circle cx="76" cy="64" r="18" fill="#397fb0"/>
            <path d="M68 64 L74 70 L86 56" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="44" y="96" width="64" height="8" rx="3" fill="#3a3a3a"/>
            <rect x="150" y="28" width="108" height="94" rx="14" fill="#fff" stroke="#dcdcdc" stroke-dasharray="6 5"/>
            <circle cx="204" cy="64" r="18" fill="none" stroke="#c8c8c8" stroke-width="2"/>
            <path d="M196 56 L212 72 M212 56 L196 72" stroke="#c8c8c8" stroke-width="2.4" stroke-linecap="round"/>
            <rect x="172" y="96" width="64" height="8" rx="3" fill="#ececec"/>
          </svg>
        </div>
        <h3>The company should be creating value</h3>
        <p>Operations and finance should be running the business. A named gap list and a roadmap replace the cycle of "send another pack," so the acquired company can execute.</p>
      </article>
      <article class="beat">
        <div class="mini">
          <svg viewBox="0 0 280 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="280" height="150" fill="#fff"/>
            <rect x="18" y="36" width="70" height="78" rx="12" fill="#f4f4f4"/>
            <rect x="30" y="78" width="10" height="22" rx="2" fill="#b0b0b0"/>
            <rect x="46" y="64" width="10" height="36" rx="2" fill="#999"/>
            <rect x="62" y="70" width="10" height="30" rx="2" fill="#b0b0b0"/>
            <circle cx="72" cy="52" r="14" fill="none" stroke="#397fb0" stroke-width="2.5"/>
            <path d="M82 62 L92 72" stroke="#397fb0" stroke-width="2.8" stroke-linecap="round"/>
            <circle cx="124" cy="75" r="11" fill="#397fb0"/>
            <path d="M135 75 H158" stroke="#397fb0" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="170" cy="75" r="11" fill="#397fb0"/>
            <path d="M181 75 H204" stroke="#397fb0" stroke-width="2.5" stroke-linecap="round"/>
            <rect x="208" y="42" width="54" height="66" rx="12" fill="#1c1c1c"/>
            <circle cx="235" cy="68" r="12" fill="#397fb0"/>
            <path d="M229 68 L233 72 L243 60" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="220" y="90" width="30" height="5" rx="2" fill="#3a3a3a"/>
          </svg>
        </div>
        <h3>Analysis first, then a handoff both sides can use</h3>
        <p>We size the gaps from diligence through day 1 to day 100 and hand off a sequenced roadmap. The build comes later. A Session is the next step, once both sides agree on what to fix first.</p>
      </article>
    </div>
  </div>
</section>


<section class="band-cta">
  <div class="wrap">
    <p class="kicker">Next step</p>
    <h2>One gap picture, and a roadmap both sides can run</h2>
    <p class="lede">Book a Session if you need the gap analysis and a sequence both the buyer and the company can follow.</p>
    <p class="hero-actions">
      <a class="btn" href="/contact">Book a Session</a>
    </p>
  </div>
</section>
  </article>
</BaseLayout>

<style>
  .diagram{border:1px solid var(--line);border-radius:10px;background:var(--paper-2);padding:.75rem;overflow:hidden}
  .diagram svg{width:100%;border-radius:6px}
  .beats,.paths{display:grid;grid-template-columns:repeat(3,1fr);gap:1.15rem}
  .beat,.path-card{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:1.1rem 1rem 1rem}
  .beat .mini,.path-card .mini{margin:0 0 .75rem;border-radius:6px;overflow:hidden;border:1px solid var(--line)}
  .beat p,.path-card p{margin:0;font-size:.95rem}
  a.path-card{text-decoration:none;color:inherit;display:block;transition:border-color .15s}
  a.path-card:hover{border-color:var(--accent)}
  .path-card .go{margin-top:.75rem;font-size:.85rem;color:var(--accent);font-weight:500}
  .reasons{display:grid;grid-template-columns:repeat(3,1fr);gap:1.15rem}
  .reason{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:1.1rem 1rem}
  .mig-back{font-size:.95rem;margin:0 0 1rem}
  .mig-back a{color:var(--accent)}
  @media(max-width:900px){
    .beats,.paths,.reasons{grid-template-columns:1fr}
  }
</style>

