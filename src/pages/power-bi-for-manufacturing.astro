---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import LineIcon from "../components/LineIcon.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, pageTitle } from "../lib/site";

const title = pageTitle("Power BI for manufacturing");
const description =
  "Power BI for mid-market manufacturing: shared shop-floor and finance KPIs, OEE and scrap in the huddle, ERP-aware models. Quickstart flat fee $3,000.";

const faqs = [
  {
    q: "Do you build separate plant and finance models?",
    a: "No. We design one semantic model with shared definitions so throughput, scrap, and P&L stop living as two sets of books.",
  },
  {
    q: "Can this work with our ERP?",
    a: "Yes. We are ERP-aware—SAP, Infor, Dynamics, Epicor, and similar systems—with practical extract and model patterns, not a greenfield data warehouse pitch.",
  },
  {
    q: "Where does the OEE Gauge fit?",
    a: "The free Alluvium OEE Gauge on AppSource helps operators see Availability × Performance × Quality at a glance. The consulting work is the trusted measures and grain behind it.",
  },
  {
    q: "What does a Quickstart cover for a plant?",
    a: "One painful report—weekly production, scrap pack, OTIF, or inventory visibility—rebuilt in two weeks. Flat fee $3,000, with training and one week of support.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      {
        "@type": "ListItem",
        position: 3,
        name: "Power BI for manufacturing",
        item: SITE.url + "/power-bi-for-manufacturing",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: SITE.url + "/power-bi-for-manufacturing",
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url + "/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Power BI for manufacturing",
    description,
    url: SITE.url + "/power-bi-for-manufacturing",
    provider: { "@type": "Organization", name: "Alluvium", url: SITE.url },
    areaServed: { "@type": "Country", name: "United States" },
    serviceType: "Power BI consulting for manufacturing",
    offers: {
      "@type": "Offer",
      name: "Power BI Quickstart",
      price: "3000",
      priceCurrency: "USD",
      description: "One painful manufacturing report rebuilt in two weeks. Flat fee $3,000.",
      url: SITE.url + "/power-bi-quickstart",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/power-bi-for-manufacturing"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs
          crumbs={[
            { href: "/", label: "Home" },
            { href: "/services", label: "Services" },
            { label: "Power BI for manufacturing" },
          ]}
        />
        <p class="kicker">By industry</p>
        <h1>Power BI for manufacturing</h1>
        <p class="lede">
          Shared KPIs for US mid-market plants—shop-floor grain that survives the huddle, finance numbers leadership will sign, and ERP-aware models that do not invent a second set of books.
        </p>
        <p class="hero-actions">
          <a class="btn" href="/contact">Book a Session</a>
          <a class="btn btn-ghost" href="/power-bi-quickstart">Power BI Quickstart — $3,000</a>
        </p>
      </div>
    </header>

    <figure class="still bw">
      <img
        src="/blog/ops-still-runs-the-plant-from-spreadsheets-hero.jpg"
        alt=""
        width="1600"
        height="900"
      />
    </figure>

    <section class="band band-alt">
      <div class="wrap prose">
        <h2>When the plant and finance stop sharing a number</h2>
        <p>
          Mid-market manufacturers rarely lack dashboards. They lack one model that ops can open at 6:30 a.m. and finance can defend in the close. Supervisors rebuild shift grain in Excel. Scrap never makes the Monday pack. The weekly ops review becomes a slide deck. Slow refresh costs downtime while quality issues keep running.
        </p>
        <p>
          Alluvium’s Power BI work for manufacturing starts with the decisions the plant already runs—throughput, OEE, scrap, schedule, inventory—and aligns them to the P&amp;L definitions finance already owns. Not a platform pitch. Not invented case-study logos.
        </p>
        <ul>
          <li>Shop-floor vs finance on shared measures—not two workbooks that never tie.</li>
          <li>OEE, throughput, scrap, and quality at line and shift grain, not only plant totals.</li>
          <li>ERP-aware modeling (SAP, Infor, Dynamics, Epicor, and similar) without a six-month “BI transformation.”</li>
          <li>Adoption in the huddle: pages people open, not posters about self-service.</li>
        </ul>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>What we do for manufacturing teams</h2>
        <div class="cards">
          <article class="card">
            <LineIcon name="operations" />
            <h3>Plant grain that matches the huddle</h3>
            <p>
              Shift, line, cell, and crew as first-class dimensions—so supervisors stop rebuilding the morning meeting in spreadsheets.
              See <a href="/blog/ops-still-runs-the-plant-from-spreadsheets">why ops still runs the plant from spreadsheets</a>.
            </p>
          </article>
          <article class="card">
            <LineIcon name="quality" />
            <h3>Scrap and quality in the pack</h3>
            <p>
              Yield, scrap, and escapes in the same Monday pack as throughput—not a plant-only report nobody brings upstairs.
              Read <a href="/blog/manufacturing-scrap-never-makes-the-pack">manufacturing scrap that never makes the pack</a>.
            </p>
          </article>
          <article class="card">
            <LineIcon name="time" />
            <h3>Speed when downtime costs money</h3>
            <p>
              Tuned models and visuals so defect and downtime signals arrive before another shift of scrap.
              Background: <a href="/blog/slow-bi-costs-manufacturing-downtime">slow BI costs manufacturing downtime</a>.
            </p>
          </article>
          <article class="card">
            <LineIcon name="finance" />
            <h3>Shared KPIs with finance</h3>
            <p>
              One semantic model for production and P&amp;L definitions. Ops and controllers argue less about which number is “real.”
            </p>
          </article>
          <article class="card">
            <LineIcon name="connect" />
            <h3>ERP-aware delivery</h3>
            <p>
              Practical extract and model patterns for the systems you already run—not a greenfield warehouse before the first useful report.
            </p>
          </article>
          <article class="card">
            <LineIcon name="dashboard" />
            <h3>Huddles over slide decks</h3>
            <p>
              Live pages for the weekly ops review instead of screenshots that are stale by the meeting.
              Related: <a href="/blog/weekly-ops-review-is-a-slide-deck">when the weekly ops review is a slide deck</a>.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="band band-alt">
      <div class="wrap prose">
        <h2>Start with one painful plant report</h2>
        <p>
          The <a href="/power-bi-quickstart">Power BI Quickstart</a> rebuilds one high-impact manufacturing report in two weeks—weekly production, inventory visibility, OTIF, scrap summary, or a similar bottleneck.
          <strong>Flat fee $3,000</strong>. Discovery, automated report, training, and one week of support included.
        </p>
        <p class="hero-actions">
          <a class="btn" href="/power-bi-quickstart">See Power BI Quickstart</a>
          <a class="btn btn-ghost" href="/contact">Book a Session</a>
        </p>
        <h2>Tools that support the floor</h2>
        <p>
          The free <a href="/power-bi-oee-gauge">Alluvium OEE Gauge</a> (live on Microsoft AppSource) shows Availability × Performance × Quality with target bands for plant-floor status at a glance.
          When the model itself is the risk, the optional <a href="/power-bi-model-health">Power BI model health score</a> reviews relationships, DAX, Power Query, and RLS.
        </p>
        <p>
          Still comparing partners? Use the manufacturing checklist:
          <a href="/how-to-choose-a-power-bi-partner">How to choose a Power BI partner for manufacturing</a>.
        </p>
      </div>
    </section>

    <section class="band faq" aria-labelledby="mfg-faq">
      <div class="wrap">
        <h2 id="mfg-faq">Manufacturing Power BI FAQs</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedLinks
      services={[
        { href: "/power-bi-quickstart", label: "Power BI Quickstart" },
        { href: "/power-bi-dashboard-optimization-ai-insights", label: "Dashboard optimization" },
        { href: "/power-bi-training", label: "Power BI training" },
        { href: "/analytics-ai-strategy-roadmap", label: "Analytics strategy roadmap" },
        { href: "/power-bi-oee-gauge", label: "Alluvium OEE Gauge" },
        { href: "/how-to-choose-a-power-bi-partner", label: "How to choose a Power BI partner" },
      ]}
      posts={[
        {
          href: "/blog/power-bi-for-manufacturing-reporting-consulting",
          label: "Power BI for manufacturing reporting consulting",
        },
        {
          href: "/blog/ops-still-runs-the-plant-from-spreadsheets",
          label: "Why ops still runs the plant from spreadsheets",
        },
        {
          href: "/blog/manufacturing-scrap-never-makes-the-pack",
          label: "Manufacturing scrap that never makes the pack",
        },
        {
          href: "/blog/slow-bi-costs-manufacturing-downtime",
          label: "Slow BI costs manufacturing downtime",
        },
        {
          href: "/blog/plant-manager-prints-the-dashboard",
          label: "When the plant manager prints the dashboard",
        },
        {
          href: "/blog/throughput-inventory-report-nobody-trusts",
          label: "Throughput inventory report nobody trusts",
        },
      ]}
    />

    <CtaBand
      heading="Put the plant and finance on one model"
      text="Book a Session to name the report that slows the huddle or the close. Or start with Power BI Quickstart—one painful manufacturing report in two weeks, flat fee $3,000."
    />
  </article>
</BaseLayout>
