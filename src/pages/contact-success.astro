---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Contact", item: SITE.url + "/contact" },
  ],
};
---
<BaseLayout
  title="Thanks — we have your note | Alluvium"
  description="Thanks for contacting Alluvium. We’ll reply about your Power BI and analytics goals."
  canonicalPath="/contact-success"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs crumbs={[{ href: "/", label: "Home" }, { href: "/contact", label: "Contact" }, { label: "Thanks" }]} />
        <p class="kicker">Contact</p>
        <h1>Thanks — we’ll reply</h1>
        <p class="lede">Power BI and data &amp; analytics insights.</p>
      </div>
    </header>
    <section class="band band-alt">
      <div class="wrap-narrow">
        <h2>Tell us about your analytics goals</h2>
        <p>Thanks — we’ll reply. We have your note and will follow up at the email you shared.</p>
        <p><a class="btn" href="/">Back to home</a></p>
      </div>
    </section>
  </article>
</BaseLayout>
