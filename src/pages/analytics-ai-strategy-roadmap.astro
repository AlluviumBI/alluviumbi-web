---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, RELATED } from "../lib/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Analytics Strategy Roadmap", item: SITE.url + "/analytics-ai-strategy-roadmap" },
    ],
  },
];
---
<BaseLayout
  title="Power BI analytics roadmap | Alluvium"
  description="Power BI analytics roadmap for manufacturing, finance, and operations. Sequence the semantic model, data quality, and 90-day work your team can staff."
  canonicalPath="/analytics-ai-strategy-roadmap"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { href: "/services", label: "Services" }, { label: "Analytics strategy roadmap" }]} />
      <p class="kicker">Services</p>
      <h1>Analytics strategy roadmap</h1>
      <p class="lede">Align data, analytics, and reporting goals. Identify the use cases that matter, design a scalable Power BI path, and sequence work from traditional reporting to asking a certified model.</p>
      <p><a class="btn" href="/contact">Book a Session</a></p>
    </div>
  </header>
  <figure class="still bw">
    <img src="/images/silt.jpg" alt="" width="1600" height="1067" />
  </figure>
  <section class="band">
    <div class="wrap prose">
      <h2>Semantic model, data quality, and sequence</h2>
      <p>Most companies do not need more dashboards. They need a sequence: which numbers leadership will actually use, which models must be certified first, and what can wait.</p>
    </div>
  </section>
  <RelatedLinks services={RELATED["/analytics-ai-strategy-roadmap"].services} posts={RELATED["/analytics-ai-strategy-roadmap"].posts} />
  <CtaBand heading="Start with the sequence, not another dashboard" text="A session is enough to name the decisions that should drive the roadmap." />
</BaseLayout>
