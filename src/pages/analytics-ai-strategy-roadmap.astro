---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE } from "../lib/site";

const faqs = [
  {
    q: "Is this an AI product roadmap?",
    a: "No. It is an analytics and BI roadmap. Conversational analytics on a certified semantic model can be in scope; GPT apps, agents, and automations are not sold on this site.",
  },
  {
    q: "Who is this for?",
    a: "C-suite and BI leaders at mid-sized companies who need a sequenced path from painful reporting to trusted Power BI, not a pile of disconnected dashboards.",
  },
  {
    q: "What do we walk away with?",
    a: "A written roadmap: current-state findings, prioritized use cases, model and governance gaps, and a 90-day sequence your team can actually staff.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Analytics Strategy Roadmap", item: SITE.url + "/analytics-ai-strategy-roadmap" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Analytics Strategy Roadmap | Power BI Path for Leadership — Alluvium"
  description="Align data, analytics, and reporting goals. Identify high-impact Power BI use cases, design a governed model path, and sequence work from traditional reporting to conversational analytics on a certified model."
  canonicalPath="/analytics-ai-strategy-roadmap"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <p class="kicker">Services</p>
      <h1>Analytics strategy roadmap</h1>
      <p class="lede">Align data, analytics, and reporting goals. Identify the use cases that matter, design a scalable Power BI path, and sequence work from traditional reporting to conversational analytics on a certified model.</p>
      <p><a class="btn" href="/contact">Book a 30-minute consult</a></p>
    </div>
  </header>
  <section class="band">
    <div class="wrap-narrow prose">
      <p>Most companies do not need more dashboards. They need a sequence: which numbers leadership will actually use, which models must be certified first, and what can wait.</p>
      <h2>What we cover</h2>
      <ul>
        <li>Current-state of reporting, models, and ownership.</li>
        <li>High-impact use cases tied to decisions, not vanity metrics.</li>
        <li>Gaps in semantic modeling, refresh, and governance.</li>
        <li>Where conversational analytics belongs: only after a certified model exists.</li>
      </ul>
      <h2>What this is not</h2>
      <p>This is not a GPT, agent, or automation roadmap. Alluvium is analytics and BI. AI on this site means asking a trusted Power BI or Fabric model. Broader automation work lives later on a separate AlluviumAI property.</p>
      <h2>How it runs</h2>
      <ol>
        <li>Discovery with the people who own the numbers and the people who use them.</li>
        <li>A written current-state and a short list of certified-model candidates.</li>
        <li>A 90-day sequence: models, reports, adoption, then conversational access if the model is ready.</li>
      </ol>
      <h2>Frequently asked questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <CtaBand heading="Start with the sequence, not another dashboard" text="Thirty minutes is enough to name the decisions that should drive the roadmap." />
</BaseLayout>
