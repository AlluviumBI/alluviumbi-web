---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "About", item: SITE.url + "/about" },
  ],
};
---
<BaseLayout
  title="Independent Power BI consulting | Alluvium"
  description="Independent Power BI consulting for mid-sized companies. Trusted models, a Monday pack that holds, and a team that can run it. Onshore, senior, hands-on."
  canonicalPath="/about"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs crumbs={[{ href: "/", label: "Home" }, { label: "About" }]} />
        <p class="kicker">Practice</p>
        <h1>About Alluvium</h1>
        <p class="lede">Independent Power BI consulting for mid-sized companies. We help executives and BI leaders get reporting people will actually use.</p>
      </div>
    </header>
    <section class="band band-alt">
      <div class="wrap prose">
        <h2>Independent Power BI consulting, not a platform sale</h2>
        <p>
          Alluvium is independent Power BI consulting for mid-sized companies. We help executives and BI leaders get reporting people will actually use: a trusted model, a Monday pack that holds, and a team that can run it. Senior, hands-on, scoped to the outcome. We do not sell a platform.
        </p>
        <p>
          We meet you where the work is. Greenfield: the first Power BI model, built from the systems you already run. A false start: licenses bought, dashboards live, and nobody trusts the numbers. Optimization: slow reports, conflicting measures, refresh that fails before the stand-up. A rebuild: one semantic model instead of dashboard sprawl. Training: so your people can operate what we leave behind. Then the next level: conversational analytics, so leaders can ask the model instead of waiting on another report.
        </p>
        <p>
          The work is all onshore. Decades of business and analytics experience, applied to Power BI, not a rotating bench.
        </p>
        <p>
          Engagements stay small on purpose. You work with the person designing the model. We serve organizations across the United States.
        </p>
        <p><a href="/services">View Power BI services</a> · <a href="/blog">Read Power BI insights</a> · <a href="/contact">Book a Session</a></p>
      </div>
    </section>
    <CtaBand />
  </article>
</BaseLayout>
