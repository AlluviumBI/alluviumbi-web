---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "About", item: SITE.url + "/about" },
  ],
};
---
<BaseLayout
  title="Independent Power BI consulting | Alluvium"
  description="Independent Power BI consulting for mid-sized companies. Optimize, rebuild, or train the team on greenfield, a false start, or a model that already exists."
  canonicalPath="/about"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs crumbs={[{ href: "/", label: "Home" }, { label: "About" }]} />
        <p class="kicker">Practice</p>
        <h1>About Alluvium</h1>
        <p class="lede">Independent Power BI consulting for mid-sized companies. Greenfield, a false start, or a model that already exists. We optimize, rebuild, or train the team.</p>
      </div>
    </header>
    <section class="band band-alt">
      <div class="wrap prose">
        <h2>Independent Power BI consulting, not a platform sale</h2>
        <p>
          Alluvium exists to help executives and BI leaders cut through analytics hype and build reporting people will actually use.
          Senior, hands-on, scoped to outcomes: a trusted model, a Monday pack that holds, and a team that can run it.
        </p>
        <p>We work at whatever stage you are in:</p>
        <ul>
          <li>Greenfield: first Power BI model, from the systems you already run</li>
          <li>False starts: licenses bought, dashboards live, nobody trusts the number</li>
          <li>Optimize what you have: slow reports, conflicting measures, refresh failures</li>
          <li>Build fresh: replace the sprawl with one certified semantic model</li>
          <li>Train the team: so your people can operate what we build</li>
        </ul>
        <p>
          Conversational analytics is optional, and only on a certified Power BI or Fabric model. Not a chatbot project.
        </p>
        <p>
          Engagements stay small on purpose. You work with the person designing the model, not a rotating bench. We do not sell a platform.
        </p>
        <p>Serving organizations across the United States.</p>
        <p><a href="/services">View Power BI services</a> · <a href="/blog">Read Power BI insights</a> · <a href="/contact">Book a Session</a></p>
      </div>
    </section>
    <CtaBand />
  </article>
</BaseLayout>
