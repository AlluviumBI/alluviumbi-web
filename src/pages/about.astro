---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "About", item: SITE.url + "/about" },
  ],
};
---
<BaseLayout
  title="Independent Power BI consulting | Alluvium"
  description="Independent Power BI consulting: trusted reporting, hands-on delivery, and a team that can run it after we leave. Onshore and senior-led."
  canonicalPath="/about"
  jsonLd={jsonLd}
>
  <article>
    <header class="hero">
      <div class="wrap">
        <Crumbs crumbs={[{ href: "/", label: "Home" }, { label: "About" }]} />
        <h1 class="page-title">About Alluvium</h1>
        <p class="lede">Independent Power BI consulting. We help leaders and the teams who own reporting build Power BI they can trust and use.</p>
      </div>
    </header>
    <section class="band band-alt">
      <div class="wrap prose">
        <h2>Independent, senior, hands-on</h2>
        <p>
          Alluvium is an independent Power BI consulting firm. We help leaders and the people who own reporting get dependable numbers, reports the meeting actually uses, and a team that can run them after we leave. We don't sell a platform.
        </p>
        <p>
          We start where you are: a first Power BI build, a rollout that stalled, slow or conflicting reports, or a refresh that fails before the stand-up. Every engagement includes training, so your people own what we build. Once the model is trusted, conversational analytics lets leaders ask it questions directly.
        </p>
        <p>
          Engagements are onshore and deliberately small. You work directly with the person designing your model, a PMP and Microsoft Certified Power BI developer. We serve organizations across the United States.
        </p>
        <p><a href="/services">View Power BI services</a> · <a href="/blog">Read Power BI insights</a> · <a href="/contact">Book a Session</a></p>
      </div>
    </section>
    <CtaBand />
  </article>
</BaseLayout>
