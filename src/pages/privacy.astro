---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE } from "../lib/site";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Privacy", item: SITE.url + "/privacy" },
  ],
};
---
<BaseLayout
  title="Privacy policy | Alluvium"
  description="How Alluvium handles information on this website and for the Alluvium OEE Gauge Power BI visual on AppSource. We do not sell personal information."
  canonicalPath="/privacy"
  jsonLd={jsonLd}
>
  <article class="hero">
    <div class="wrap-narrow prose">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { label: "Privacy" }]} />
      <p class="kicker">Legal</p>
      <h1>Privacy</h1>
      <p>Alluvium is an independent advisory practice based in Wisconsin, United States. This policy describes how we treat information related to our website and to Alluvium Power BI custom visuals published on Microsoft AppSource.</p>
      <h2>Information you provide</h2>
      <p>If you contact us, we use the details you share—such as name, email, company, and message—to respond to your inquiry. We do not sell personal information.</p>
      <h2>Contact form</h2>
      <p>Contact form submissions are processed by Netlify Forms. The intended recipient is info@alluviumbi.com.</p>
      <h2>Logs and cookies</h2>
      <p>Hosting providers may collect standard technical logs (for example, IP address and user agent) to operate and secure the site. We do not use advertising cookies.</p>
      <h2>Alluvium OEE Gauge (Power BI visual)</h2>
      <p>This privacy statement also covers the Alluvium OEE Gauge Power BI custom visual published by Alluvium LLC on Microsoft AppSource.</p>
      <p>The visual runs inside Microsoft Power BI Desktop and Power BI Service. It does not collect, transmit, or store personal information. It makes no network calls from the visual runtime and only renders the measures and fields you bind in your report. Report data remains in your Microsoft Power BI tenant under your Microsoft agreement.</p>
      <p>Questions: use the <a href="/contact">contact page</a> or info@alluviumbi.com.</p>
      <h2>Contact</h2>
      <p>Questions about this policy can be sent through the <a href="/contact">contact page</a>.</p>
    </div>
  </article>
</BaseLayout>
