---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, pageTitle } from "../lib/site";

const title = pageTitle("Power BI migration");
const description =
  "Leaving Tableau, Excel as BI, or a homegrown custom stack? Pick your from-pain and move to Power BI.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Power BI migration", item: SITE.url + "/power-bi-migration" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: SITE.url + "/power-bi-migration",
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url + "/" },
  },
];
---
<BaseLayout title={title} description={description} canonicalPath="/power-bi-migration" jsonLd={jsonLd}>
  <article>
<header class="hero">
  <div class="wrap">
        <Crumbs crumbs={[
            { href: "/", label: "Home" },
            { href: "/services", label: "Services" },
            { label: "Power BI migration" }
          ]} />
      </div>
      <div class="wrap hero-grid">
        <div>
      <p class="kicker">Migrations · Power BI</p>
      <h1>Choose what you are leaving</h1>
      <p class="lede">Owners, operations leads, and finance leads usually leave one of three stacks. Tableau costs too much and is hard to staff. Excel has become the real reporting system. Or a homegrown build no longer keeps up. Pick the path that matches the pain, and we size the move to Power BI.</p>
      <p class="hero-actions">
        <a class="btn" href="/contact">Book a Session</a>
      </p>
    </div>
    <figure class="diagram" aria-label="Three from-pains map into Power BI">
