---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import LineIcon from "../components/LineIcon.astro";
import { SITE } from "../lib/site";

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": SITE.url,
  name: "Alluvium",
  url: SITE.url,
  description: "Power BI and analytics delivery for mid-sized companies. Conversational analytics means asking a certified semantic model.",
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE.url + "/",
  name: "Alluvium",
  url: SITE.url,
  description: SITE.description,
};
---
<BaseLayout
  title="Microsoft Power BI consulting | Alluvium"
  description="Power BI consulting for mid-sized companies. Trusted numbers in the meeting, not more dashboards. Quickstart, models, training, and advisory. Book a Session."
  canonicalPath="/"
  jsonLd={[org, website]}
>
  <section class="hero">
    <div class="wrap">
      <h1>Microsoft Power BI consulting</h1>
      <p class="lede">From dashboards to decisions</p>
      <p class="hero-actions">
        <a class="btn" href="/contact">Book a Session</a>
        <a class="btn btn-ghost" href="/power-bi-quickstart">Power BI Quickstart</a>
      </p>
    </div>
  </section>

  <section class="band band-alt" aria-labelledby="principles">
    <div class="wrap">
      <h2 id="principles">Trusted Power BI models for mid-sized companies</h2>
      <p class="lede">Automate the reporting you already run, then ask a certified Power BI or Fabric semantic model.</p>
      <p>
        We don’t build dashboards or chase buzzwords just to tick boxes. Start with a
        <a href="/power-bi-quickstart">Power BI Quickstart</a>
        when one report is the bottleneck. When the model is trusted,
        <a href="/conversational-analytics">conversational analytics</a>
        sits on that model. Not a chatbot project.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="who">
    <div class="wrap">
      <p class="kicker">Who we serve</p>
      <h2 id="who">Power BI consulting for finance, ops, and sales</h2>
      <div class="cards">
        <article class="card">
          <LineIcon name="finance" />
          <h3>Finance</h3>
          <p>Close, forecast vs actuals, and one P&amp;L/cash number leadership will sign. See <a href="/blog/excel-vs-power-bi-financial-reporting">Excel vs Power BI for financial reporting</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="operations" />
          <h3>Operations</h3>
          <p>Throughput, schedule, and shop-floor vs finance without a second set of books.</p>
        </article>
        <article class="card">
          <LineIcon name="sales" />
          <h3>Sales</h3>
          <p>Pipeline and bookings that finance will accept, not a forecast that never ties out.</p>
        </article>
        <article class="card">
          <LineIcon name="marketing" />
          <h3>Marketing</h3>
          <p>Spend to pipeline on the same definitions sales and finance already use.</p>
        </article>
        <article class="card">
          <LineIcon name="it" />
          <h3>IT</h3>
          <p>Refresh, gateways, capacity, and certified models instead of sprawl. Read <a href="/blog/unused-power-bi-licenses">unused Power BI licenses</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="project" />
          <h3>Project management</h3>
          <p>Backlog, delivery, and <a href="/data-project-management-change-leadership">analytics project management</a> so the model actually gets used.</p>
        </article>
        <article class="card">
          <LineIcon name="supply" />
          <h3>Supply chain</h3>
          <p>Inventory, OTIF, and supplier numbers in the same model as finance.</p>
        </article>
        <article class="card">
          <LineIcon name="hr" />
          <h3>HR</h3>
          <p>Headcount, labor, and people costs that actually tie to the P&amp;L.</p>
        </article>
        <article class="card">
          <LineIcon name="quality" />
          <h3>Quality</h3>
          <p>Scrap, yield, and customer escapes in the Monday pack, not a plant-only report.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band band-alt band-quickstart" aria-labelledby="qs-band">
    <div class="wrap band-center">
      <h2 id="qs-band">Power BI Quickstart</h2>
      <p class="lede">Solve one painful reporting problem in two weeks. Flat fee $3,000.</p>
      <p class="hero-actions">
        <a class="btn" href="/power-bi-quickstart">See Power BI Quickstart</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="offerings">
    <div class="wrap">
      <p class="kicker">Offerings</p>
      <h2 id="offerings">Power BI services from Quickstart to retainer</h2>
      <p class="lede">
        Alluvium helps organizations evolve from dashboards to decisions — Power BI expertise, plus the option to ask a certified model.
      </p>
      <div class="cards-2">
        <article class="card">
          <LineIcon name="strategy" />
          <h3>Analytics strategy roadmap</h3>
          <p>Align data, analytics, and reporting goals. Identify high-impact use cases and sequence work from traditional reporting to asking a certified model.</p>
          <p><a href="/analytics-ai-strategy-roadmap">See the analytics strategy roadmap</a></p>
        </article>
        <article class="card">
          <LineIcon name="project" />
          <h3>Data &amp; Analytics project management and change leadership</h3>
          <p>End-to-end oversight for analytics and Power BI initiatives. Scope, teams, and timelines, plus adoption through communication and training.</p>
          <p><a href="/data-project-management-change-leadership">See data &amp; analytics project management</a></p>
        </article>
        <article class="card">
          <LineIcon name="dashboard" />
          <h3>Dashboard optimization</h3>
          <p>Audit your existing Power BI ecosystem — performance, adoption, and value — then tighten models and visuals so people actually use them.</p>
          <p><a href="/power-bi-dashboard-optimization-ai-insights">See dashboard optimization</a></p>
        </article>
        <article class="card">
          <LineIcon name="retainer" />
          <h3>Managed advisory retainer</h3>
          <p>Ongoing strategic guidance on Power BI governance, semantic modeling, and program evolution.</p>
          <p><a href="/managed-advisory-retainer">See the managed advisory retainer</a></p>
        </article>
        <article class="card">
          <LineIcon name="training" />
          <h3>Training</h3>
          <p>Get the team fluent on the Power BI model they already paid for — hands-on sessions, not a slide deck.</p>
          <p><a href="/power-bi-training">See Power BI training</a></p>
        </article>
        <article class="card">
          <LineIcon name="conversational" />
          <h3>Conversational analytics</h3>
          <p>Ask a certified Power BI or Fabric semantic model. Governed questions on trusted measures—not a chatbot project.</p>
          <p><a href="/conversational-analytics">See conversational analytics</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="why">
    <div class="wrap">
      <h2 id="why">Why choose Alluvium for Power BI consulting?</h2>
      <div class="cards">
        <article class="card">
          <LineIcon name="focus" />
          <h3>Strategic Focus</h3>
          <p>We emphasize advisory, data strategy, and Power BI roadmaps—aligning analytics initiatives to real business outcomes.</p>
        </article>
        <article class="card">
          <LineIcon name="scale" />
          <h3>Scalable Solutions</h3>
          <p>Our frameworks and advisory models grow with you—adapting as your data and analytics needs evolve.</p>
        </article>
        <article class="card">
          <LineIcon name="expertise" />
          <h3>Proven Expertise</h3>
          <p>Years of hands-on Power BI and data strategy experience—backed by practical, real-world methods across industries. We do not name clients here; the work is designed to transfer.</p>
        </article>
      </div>
      <article class="card" style="margin-top:1.25rem;">
        <LineIcon name="client" />
          <h3>Client-Centric Approach</h3>
          <p>We meet you where you are, tailoring every engagement to your goals, systems, and pace of change.</p>
        </article>
      <p><a href="/about">About Alluvium</a></p>
    </div>
  </section>

  <section class="band band-alt" aria-labelledby="steps">
    <div class="wrap">
      <h2 id="steps">Get started with Power BI consulting in 3 steps</h2>
      <div class="steps">
        <article>
          <p class="step-num">01</p>
          <h3>Book a Session</h3>
          <p>Talk through your data, analytics, or reporting challenges and goals.</p>
        </article>
        <article>
          <p class="step-num">02</p>
          <h3>Roadmap or advisory package</h3>
          <p>We’ll design a focused roadmap or advisory package—covering strategy, optimization, or ongoing partnership.</p>
        </article>
        <article>
          <p class="step-num">03</p>
          <h3>Implement</h3>
          <p>Implement with our guidance and watch reporting become something people actually use.</p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand heading="Let’s connect" text="Tell us a bit about your goals, and we’ll explore how Alluvium can help you simplify data, scale analytics, and put trusted numbers in the meeting." />
</BaseLayout>
