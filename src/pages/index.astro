---
import BaseLayout from "../layouts/BaseLayout.astro";
import LineIcon from "../components/LineIcon.astro";
import { SITE } from "../lib/site";

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": SITE.url,
  name: "Alluvium",
  url: SITE.url,
  description: "Microsoft Power BI consulting: reporting your team can rely on.",
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE.url + "/",
  name: "Alluvium",
  url: SITE.url,
  description: SITE.description,
};
---
<BaseLayout
  title="Microsoft Power BI consulting | Alluvium"
  description="Microsoft Power BI consulting: reporting your team can rely on. Quickstart, strategy, optimization, training, and advisory. Start a conversation about your reporting needs."
  canonicalPath="/"
  jsonLd={[org, website]}
>
  <section class="hero">
    <div class="wrap">
      <h1>Microsoft Power BI consulting</h1>
      <p class="lede">Power BI consulting that turns your data into reporting your team can rely on. Clear numbers, delivered with care, built to last.</p>
      <p class="hero-actions">
        <a class="btn" href="/contact">Start a conversation</a>
        <a class="btn btn-ghost" href="/power-bi-quickstart">Power BI Quickstart</a>
      </p>
    </div>
  </section>

  <section class="band band-alt" aria-label="Our approach">
    <div class="wrap">
      <p class="lede">Good reporting answers the questions your leaders actually ask, and gives the same answer every time.</p>
      <p>
        We build what gets used, not dashboards for show. If one report is slowing you down, start with a
        <a href="/power-bi-quickstart">Power BI Quickstart</a>.
        If the bigger issue is the data underneath, we start there.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="who">
    <div class="wrap">
      <h2 id="who" class="section-title">Who we serve</h2>
      <div class="cards">
        <article class="card">
          <LineIcon name="finance" />
          <h3>Finance</h3>
          <p>Close faster, compare forecast to actuals, and bring leadership P&amp;L and cash figures they can sign off on. See <a href="/power-bi-for-finance">Power BI for finance</a> and <a href="/blog/excel-vs-power-bi-financial-reporting">Excel vs Power BI for financial reporting</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="operations" />
          <h3>Operations</h3>
          <p>See throughput and schedule clearly, with the shop floor and finance working from the same numbers. See <a href="/power-bi-for-manufacturing">Power BI for manufacturing</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="sales" />
          <h3>Sales</h3>
          <p>Pipeline and bookings reporting that finance agrees with, so the forecast finally ties out. See <a href="/power-bi-for-sales">Power BI for sales</a> and <a href="/blog/sales-forecast-vs-finance-bookings">sales forecast vs finance bookings</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="marketing" />
          <h3>Marketing</h3>
          <p>Connect campaign spend to pipeline, using the same definitions as sales and finance.</p>
        </article>
        <article class="card">
          <LineIcon name="it" />
          <h3>IT</h3>
          <p>We help IT keep Power BI healthy: reliable refresh, sound gateways and capacity, and reports with clear owners. Read <a href="/blog/unused-power-bi-licenses">unused Power BI licenses</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="project" />
          <h3>Project management</h3>
          <p>A clear backlog and realistic delivery dates keep analytics projects on track and in use. See <a href="/data-project-management-change-leadership">data and analytics project management</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="supply" />
          <h3>Supply chain</h3>
          <p>Track inventory, on-time delivery, and supplier performance alongside the financials. See <a href="/power-bi-for-supply-chain">Power BI for supply chain</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="hr" />
          <h3>HR</h3>
          <p>Give HR headcount, labor, and people-cost reporting that ties to the P&amp;L. See <a href="/power-bi-for-hr">Power BI for HR</a>.</p>
        </article>
        <article class="card">
          <LineIcon name="quality" />
          <h3>Quality</h3>
          <p>Put scrap, yield, and customer escapes in front of leadership, not buried in a plant report. See <a href="/power-bi-for-quality">Power BI for quality</a>.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band band-alt band-quickstart" aria-labelledby="qs-band">
    <div class="wrap band-center">
      <h2 id="qs-band">Power BI Quickstart</h2>
      <p class="lede">Your most painful report, rebuilt in two weeks, with training and a week of support.</p>
      <p class="hero-actions">
        <a class="btn" href="/power-bi-quickstart">See Power BI Quickstart</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="offerings">
    <div class="wrap">
      <h2 id="offerings" class="section-title">Offerings</h2>
      <div class="cards-2">
        <article class="card">
          <LineIcon name="strategy" />
          <h3>Analytics strategy roadmap</h3>
          <p>A prioritized plan for your reporting: the decisions it must support, the data required, and what to build first.</p>
          <p class="card-cta"><a href="/analytics-ai-strategy-roadmap">See the analytics strategy roadmap</a></p>
        </article>
        <article class="card">
          <LineIcon name="project" />
          <h3>Data and analytics project management</h3>
          <p>Experienced, PMP-led management of scope, schedule, and rollout, so projects land on time and get adopted.</p>
          <p class="card-cta"><a href="/data-project-management-change-leadership">See data and analytics project management</a></p>
        </article>
        <article class="card">
          <LineIcon name="dashboard" />
          <h3>Dashboard optimization</h3>
          <p>A review of your existing Power BI for speed, usage, and conflicting numbers, followed by the fixes that make it faster and more trusted.</p>
          <p class="card-cta"><a href="/power-bi-dashboard-optimization-ai-insights">See dashboard optimization</a></p>
        </article>
        <article class="card">
          <LineIcon name="retainer" />
          <h3>Managed advisory retainer</h3>
          <p>Ongoing expert support after launch to keep reports accurate, current, and consistent.</p>
          <p class="card-cta"><a href="/managed-advisory-retainer">See the managed advisory retainer</a></p>
        </article>
        <article class="card">
          <LineIcon name="training" />
          <h3>Training</h3>
          <p>Hands-on training built around your own reports and data, not sample files.</p>
          <p class="card-cta"><a href="/power-bi-training">See Power BI training</a></p>
        </article>
        <article class="card">
          <LineIcon name="conversational" />
          <h3>Conversational analytics</h3>
          <p>Ask questions of your Power BI or Fabric data in plain language and get answers grounded in your reporting.</p>
          <p class="card-cta"><a href="/conversational-analytics">See conversational analytics</a></p>
        </article>
        <article class="card">
          <LineIcon name="connect" />
          <h3>Power BI migration</h3>
          <p>Move from legacy reporting tools to Power BI, rebuilt properly rather than copied file by file.</p>
          <p class="card-cta"><a href="/power-bi-migration">See Power BI migration</a></p>
        </article>
        <article class="card">
          <LineIcon name="decision" />
          <h3>Acquisition performance visibility</h3>
          <p>Clear performance reporting after an acquisition: a gap analysis and a roadmap for the first 100 days.</p>
          <p class="card-cta"><a href="/acquisition-performance-visibility">See acquisition performance visibility</a></p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
