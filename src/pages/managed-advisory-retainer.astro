---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Crumbs from "../components/Crumbs.astro";
import { SITE, RELATED } from "../lib/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: SITE.url + "/services" },
      { "@type": "ListItem", position: 3, name: "Managed Advisory Retainer", item: SITE.url + "/managed-advisory-retainer" },
    ],
  },
];
---
<BaseLayout
  title="Managed Power BI advisory retainer | Alluvium"
  description="Managed Power BI advisory: semantic model stewardship, RLS, refresh and gateway, and dashboard optimization without standing up a large internal BI team."
  canonicalPath="/managed-advisory-retainer"
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="wrap">
      <Crumbs crumbs={[{ href: "/", label: "Home" }, { href: "/services", label: "Services" }, { label: "Managed advisory retainer" }]} />
      <p class="kicker">Services</p>
      <h1>Managed advisory retainer</h1>
      <p class="lede">Ongoing guidance on Power BI governance, semantic modeling, and program evolution—without standing up a large internal team.</p>
      <p><a class="btn" href="/contact">Book a Session</a></p>
    </div>
  </header>
  <figure class="still bw">
    <img src="/blog/who-can-change-a-measure-hero.jpg" alt="" width="1600" height="900" />
  </figure>
  <section class="band">
    <div class="wrap prose">
      <h2>Semantic model, RLS, refresh, and gateway stewardship</h2>
      <p>Dashboards drift. Measures fork. A retainer keeps a senior pair of eyes on the model so that does not become the culture.</p>
    </div>
  </section>
  <RelatedLinks services={RELATED["/managed-advisory-retainer"].services} posts={RELATED["/managed-advisory-retainer"].posts} />
  <CtaBand heading="Keep the model trustworthy month after month" text="A session is enough to see whether a retainer fits better than a one-off project." />
</BaseLayout>
