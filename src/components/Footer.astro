---
import { NAV, SERVICES } from "../lib/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="logo" style="margin:0 0 0.75rem;">
        <img src="/brand/logo-footer.png" alt="Alluvium" width="160" height="32" />
      </p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/about">About</a></li>
      </ul>
    </div>
    <div>
      <h2>Services</h2>
      <ul>
        {SERVICES.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Legal</h2>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
      <p>© {year} Alluvium LLC</p>
    </div>
  </div>
</footer>
