---
import { NAV, SITE } from "../lib/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="logo" style="margin:0 0 0.75rem;">
        <img src="/brand/logo-footer.svg" alt="Alluvium" width="160" height="32" />
      </p>
      <p>Strategic Power BI consulting. Conversational analytics on a certified semantic model.</p>
      <p><a class="btn" href="/contact">Book a 30-minute consult</a></p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Legal</h2>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
      <p>© {year} Alluvium LLC.</p>
    </div>
  </div>
</footer>
