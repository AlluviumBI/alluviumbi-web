---
import { NAV } from "../lib/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      <img src="/brand/logo-header.png" alt="Alluvium" width="180" height="36" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="nav-toggle">
      Menu
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul>
        {NAV.map((item) => {
          const href = item.href;
          const current = href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
          return (
            <li>
              <a href={href} aria-current={current ? "page" : undefined}>{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
    <a class="btn header-cta" href="/contact">Book a 30-minute consult</a>
  </div>
</header>
<script>
  const btn = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  btn?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open");
    btn.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
