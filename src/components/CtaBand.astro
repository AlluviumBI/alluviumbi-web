---
const {
  heading = "Book a Session",
  text = "Tell us about the reporting or analytics problem that is slowing decisions. We will map a practical next step.",
} = Astro.props;
---
<section class="band band-cta" aria-labelledby="cta-heading">
  <div class="wrap">
    <p class="kicker">Next step</p>
    <h2 id="cta-heading">{heading}</h2>
    <p class="lede">{text}</p>
    <p><a class="btn" href="/contact">Book a Session</a></p>
  </div>
</section>
