---
interface Item {
  href: string;
  label: string;
}
interface Props {
  services: Item[];
  posts: Item[];
}
const { services, posts } = Astro.props;
---
<section class="band band-alt related" aria-labelledby="related-heading">
  <div class="wrap">
    <h2 id="related-heading">Related services and insights</h2>
    <div class="cards-2">
      <div>
        <h3>Services</h3>
        <ul>
          {services.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Insights</h3>
        <ul>
          {posts.map((p) => (
            <li><a href={p.href}>{p.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
